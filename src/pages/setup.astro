---
import BaseLayout from "../layouts/BaseLayout.astro";
import { db, AppUser } from "astro:db";
import { eq } from "astro:db";

// Gate on SETUP_TOKEN. Once any admin exists the page is permanently disabled.
const setupToken = process.env.SETUP_TOKEN ?? "";

const [existingAdmin] = await db
  .select({ did: AppUser.did })
  .from(AppUser)
  .where(eq(AppUser.role, "admin"));

const alreadyConfigured = !!existingAdmin;

type Result =
  | { type: "success"; handle: string }
  | { type: "error"; message: string };

let result: Result | null = null;

if (!alreadyConfigured && setupToken && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const token = form.get("token")?.toString() ?? "";
  const did = form.get("did")?.toString().trim() ?? "";

  if (token !== setupToken) {
    result = { type: "error", message: "Invalid setup token." };
  } else if (!did.startsWith("did:")) {
    result = { type: "error", message: "Please enter a valid ATProto DID (starts with did:)." };
  } else {
    const [existing] = await db.select().from(AppUser).where(eq(AppUser.did, did));
    if (existing) {
      await db.update(AppUser).set({ role: "admin" }).where(eq(AppUser.did, did));
      result = { type: "success", handle: existing.handle };
    } else {
      // User hasn't logged in yet — pre-create the row with admin role
      await db.insert(AppUser).values({
        did,
        handle: did,
        role: "admin",
        createdAt: new Date(),
      });
      result = { type: "success", handle: did };
    }
  }
}
---

<BaseLayout title="Site Setup" description="">
  <section class="setup-page">
    <div class="container">
      <div class="setup-card">
        <div class="setup-logo">DevRel<span class="logo-ish">(ish)</span></div>

        {alreadyConfigured ? (
          <div class="state-block">
            <div class="state-icon">✓</div>
            <h1>Already configured</h1>
            <p>An admin account exists. Sign in with your Atmosphere account to access the dashboard.</p>
            <a href="/auth/login" class="btn btn-primary">Go to login →</a>
          </div>

        ) : !setupToken ? (
          <div class="state-block">
            <div class="state-icon muted">◎</div>
            <h1>Setup not available</h1>
            <p>Set a <code>SETUP_TOKEN</code> environment variable to enable first-run admin setup.</p>
          </div>

        ) : result?.type === "success" ? (
          <div class="state-block">
            <div class="state-icon">✓</div>
            <h1>Admin configured!</h1>
            <p>
              <strong>{result.handle}</strong> now has admin access.
              Sign in with that Atmosphere account to access the admin dashboard.
              Remove <code>SETUP_TOKEN</code> from your environment for security.
            </p>
            <a href="/auth/login" class="btn btn-primary">Sign in →</a>
          </div>

        ) : (
          <>
            <h1>First-run setup</h1>
            <p class="setup-subtitle">Grant admin access to an ATProto DID.</p>

            <form method="POST" class="setup-form">
              {result?.type === "error" && (
                <div class="alert alert-error" role="alert">{result.message}</div>
              )}

              <div class="form-group">
                <label for="token">Setup token *</label>
                <input
                  id="token"
                  name="token"
                  type="password"
                  placeholder="Paste your SETUP_TOKEN value"
                  required
                  autocomplete="off"
                />
              </div>

              <div class="form-group">
                <label for="did">ATProto DID *</label>
                <input
                  id="did"
                  name="did"
                  type="text"
                  placeholder="did:plc:abc123..."
                  required
                  autocomplete="off"
                />
                <span class="form-hint">
                  Your DID is usually shown in your account settings. You can also resolve it from
                  any AT Protocol server — <code>https://&lt;your-pds&gt;/xrpc/com.atproto.identity.resolveHandle?handle=&lt;your-handle&gt;</code>
                  (Bluesky users can use <code>bsky.social</code> as the server).
                </span>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
                Grant admin access →
              </button>
            </form>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .setup-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 3rem 0;
  }

  .setup-card {
    max-width: 480px;
    margin-inline: auto;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
  }

  .setup-logo {
    font-family: var(--font-display);
    font-size: var(--size-2xl);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .logo-ish {
    color: var(--color-text-muted);
    font-size: 0.85em;
  }

  h1 {
    font-size: var(--size-2xl);
    margin-bottom: 0.375rem;
    text-align: center;
  }

  .setup-subtitle {
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: 1.75rem;
    font-size: var(--size-base);
  }

  .setup-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .state-block {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .state-block p {
    color: var(--color-text-muted);
    font-size: var(--size-sm);
    max-width: 36ch;
  }

  .state-block code {
    background: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.4rem;
    font-size: 0.9em;
  }

  .state-icon {
    font-size: 2.5rem;
    color: var(--color-accent);
    font-family: var(--font-display);
    line-height: 1;
  }

  .state-icon.muted {
    color: var(--color-text-light);
  }
</style>
