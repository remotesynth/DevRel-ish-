---
import BaseLayout from "../../layouts/BaseLayout.astro";

const redirectTo = Astro.url.searchParams.get("redirect") ?? "";
const errorParam = Astro.url.searchParams.get("error") ?? "";

if (Astro.locals.user) {
  const dest = redirectTo.startsWith("/") ? redirectTo :
    (Astro.locals.user.role === "admin" ? "/admin" : "/dashboard");
  return Astro.redirect(dest);
}
---

<BaseLayout title="Sign in">
  <section class="auth-page">
    <div class="container">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-logo" aria-hidden="true">◎</div>
          <h1>Welcome back</h1>
          <p>Sign in with your AT Protocol account to manage your DevRel(ish) group.</p>
        </div>

        {errorParam && (
          <div class="alert alert-error" role="alert">{errorParam}</div>
        )}

        <div id="login-error" class="alert alert-error" role="alert" hidden></div>

        <form id="login-form" class="auth-form" novalidate>
          <div class="form-group">
            <label for="handle">AT Protocol handle</label>
            <input
              id="handle"
              name="handle"
              type="text"
              required
              autocomplete="username"
              autocapitalize="none"
              placeholder="you.bsky.social or you.example.com"
            />
          </div>

          <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Continue →
          </button>
        </form>

        <p class="auth-footer">
          Works with Bluesky, self-hosted PDSes, and any ATProto account.
        </p>
        <p class="auth-footer">
          New to DevRel(ish)?{" "}
          <a href="/groups/register">Start a group</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorEl = document.getElementById("login-error") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const handle = (form.elements.namedItem("handle") as HTMLInputElement).value.trim();
    if (!handle) return;

    errorEl.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = "Redirecting…";

    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ handle }),
      });
      const data = await res.json();
      if (!res.ok || !data.url) {
        throw new Error(data.error ?? "Sign-in failed.");
      }
      window.location.href = data.url;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : "Sign-in failed. Please try again.";
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Continue →";
    }
  });
</script>

<style>
  .auth-page {
    min-height: calc(100vh - 64px - 200px);
    display: flex;
    align-items: center;
    padding: 3rem 0;
  }

  .auth-card {
    max-width: 420px;
    margin-inline: auto;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-logo {
    font-size: 3rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    line-height: 1;
  }

  .auth-header h1 {
    font-size: var(--size-3xl);
    margin-bottom: 0.375rem;
  }

  .auth-header p {
    color: var(--color-text-muted);
    font-size: var(--size-sm);
    max-width: none;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .auth-footer {
    text-align: center;
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    max-width: none;
  }
</style>
