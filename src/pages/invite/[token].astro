---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db, AppUser, Groups, GroupInvites, AtGroups, eq } from "astro:db";
import { getPdsSession, pdsPut } from "../../lib/atproto-pds";
import { buildAddress } from "../../lib/atproto-records";

const { token } = Astro.params;
if (!token) return Astro.redirect("/");

const [invite] = await db.select().from(GroupInvites).where(eq(GroupInvites.id, token));

const now = new Date();
const isExpired = !invite || invite.expiresAt < now;

const [group] = invite
  ? await db.select().from(Groups).where(eq(Groups.id, invite.groupId))
  : [];

const isValid = !!invite && !isExpired && !!group && group.status === "active";

const user = Astro.locals.user;

let successMsg = "";
let errorMsg = "";

if (isValid && user && Astro.request.method === "POST") {
  if (user.groupId) {
    errorMsg = "You are already associated with a group.";
  } else {
    await db
      .update(AppUser)
      .set({ groupId: group!.id })
      .where(eq(AppUser.did, user.did));

    // Consume the invite so it can't be reused
    await db.delete(GroupInvites).where(eq(GroupInvites.id, token));

    // Update the group's PDS record to include the new co-organizer's DID (best-effort)
    if (group!.atUri && group!.atCid && group!.managerId) {
      try {
        const organizerSession = await getPdsSession(group!.managerId);
        if (organizerSession) {
          const [atGroup] = await db
            .select({ coOrganizers: AtGroups.coOrganizers })
            .from(AtGroups)
            .where(eq(AtGroups.uri, group!.atUri));
          const existing: string[] = atGroup?.coOrganizers
            ? (() => { try { return JSON.parse(atGroup.coOrganizers); } catch { return []; } })()
            : [];
          const coOrganizers = [...new Set([...existing, user.did])];

          await pdsPut(organizerSession, group!.atUri, {
            name: group!.name,
            description: group!.description,
            ...(() => {
              const address = buildAddress({
                locality: group!.city,
                region: group!.region,
                country: group!.country,
              });
              return address ? { location: address } : {};
            })(),
            ...(group!.category ? { category: group!.category } : {}),
            coOrganizers,
            createdAt: group!.createdAt.toISOString(),
          });
        }
      } catch (err) {
        console.warn("[invite] Could not update group PDS record with co-organizer:", err);
      }
    }

    successMsg = `You now have co-organizer access to ${group!.name}.`;
  }
}
---

<BaseLayout title="Accept invitation">
  <section class="invite-page">
    <div class="container">
      <div class="invite-card">
        <div class="invite-logo" aria-hidden="true">◎</div>

        {!isValid ? (
          <div class="state-block">
            <h1>{isExpired ? "Invite expired" : "Invalid invite"}</h1>
            <p>
              {isExpired
                ? "This invite link has expired. Ask the group organizer to generate a new one."
                : "This invite link is not valid."}
            </p>
            <a href="/" class="btn btn-ghost">Go home →</a>
          </div>

        ) : successMsg ? (
          <div class="state-block success">
            <div class="state-icon">✓</div>
            <h1>You're in!</h1>
            <p>{successMsg}</p>
            <a href="/dashboard" class="btn btn-primary">Go to dashboard →</a>
          </div>

        ) : (
          <>
            <h1>You've been invited</h1>
            <p class="invite-subtitle">
              You've been invited to co-organize <strong>{group!.name}</strong>.
              {user
                ? " Accept the invitation below."
                : " Sign in with your AT Protocol account first, then return to this link to accept."}
            </p>

            {errorMsg && <div class="alert alert-error">{errorMsg}</div>}

            {user ? (
              <form method="POST" class="invite-form">
                <div class="who-block">
                  <span class="who-label">Accepting as</span>
                  <span class="who-handle">@{user.handle}</span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
                  Accept invitation →
                </button>
              </form>
            ) : (
              <a href={`/auth/login?redirect=/invite/${token}`} class="btn btn-primary btn-lg" style="display:block;text-align:center;">
                Sign in with ATProto →
              </a>
            )}
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .invite-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 3rem 0;
  }

  .invite-card {
    max-width: 440px;
    margin-inline: auto;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-panel);
    text-align: center;
  }

  .invite-logo {
    font-size: 3rem;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    line-height: 1;
  }

  h1 {
    font-size: var(--text-3xl);
    margin-bottom: 0.375rem;
  }

  .invite-subtitle {
    color: var(--color-ink-2);
    font-size: var(--text-base);
    margin-bottom: 1.5rem;
    max-width: none;
  }

  .invite-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .who-block {
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .who-label {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .who-handle {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
  }

  .state-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .state-block p {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    max-width: 32ch;
  }

  .state-icon {
    font-size: 2.5rem;
    color: var(--color-ok);
    line-height: 1;
  }
</style>
