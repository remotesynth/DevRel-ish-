---
/**
 * Previously: five glyphs drifting on an infinite @keyframes loop above a
 * three-stop gradient number, everything centred. Both were named in the audit.
 * The joke is good; it didn't need decoration to land.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Lost in the hallway track"
  description="This page doesn't exist. It probably wandered off to a side session."
>
  <section class="not-found">
    <div class="container">
      <p class="code">404</p>
      <h1>Lost in the hallway track</h1>

      <p class="subtitle">
        This page wandered off to a side session and hasn&rsquo;t come back. It
        probably grabbed a snack and started a deeply unplanned conversation about
        developer experience metrics.
      </p>

      <div class="rail">
        <h2 class="rail-title">Maybe you wanted</h2>
      </div>

      <ul class="suggestions" role="list">
        <li>
          <a href="/gatherings"><span>Upcoming gatherings</span></a>
          <span class="gloss">see what&rsquo;s on</span>
        </li>
        <li>
          <a href="/groups"><span>All groups</span></a>
          <span class="gloss">find your people</span>
        </li>
        <li>
          <a href="/groups/register"><span>Start a group</span></a>
          <span class="gloss">be the one who did</span>
        </li>
        <li>
          <a href="/how-it-works"><span>How it works</span></a>
          <span class="gloss">the orientation session</span>
        </li>
      </ul>

      <p class="fine-print">
        If a link brought you here, it may have moved. The conference schedule
        changed again. It always does.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .container {
    max-width: 46rem;
  }

  /* The number is set in the display face at real display size — it carries the
     page on its own, which is what the drifting glyphs were compensating for. */
  .code {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 0, "WONK" 1;
    font-weight: 700;
    font-size: var(--text-display);
    line-height: 0.82;
    letter-spacing: -0.05em;
    color: var(--color-accent);
    max-width: none;
  }

  h1 {
    margin-top: var(--space-2xs);
    max-width: 14ch;
  }

  .subtitle {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xl);
    max-width: 52ch;
    color: var(--color-ink-2);
  }

  .suggestions {
    list-style: none;
    margin-bottom: var(--space-xl);
  }

  .suggestions li {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .suggestions a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .suggestions a:hover {
    color: var(--color-accent);
  }

  .gloss {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-left: auto;
    text-align: right;
  }

  .fine-print {
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 52ch;
  }

  @media (max-width: 40rem) {
    .suggestions li {
      flex-direction: column;
      gap: 0;
      align-items: flex-start;
    }

    .gloss {
      margin-left: 0;
      text-align: left;
    }

    .suggestions a {
      white-space: normal;
    }
  }
</style>
