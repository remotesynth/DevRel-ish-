---
/**
 * Macrostructure 20 · Ecosystem Index.
 *
 * The previous homepage was the LLM default: a two-column hero with floating
 * decorative glyphs, three equal icon-tile feature cards, a grid, and a centred
 * CTA card. It declared. This page browses instead — several rails, each a
 * different cut of what's happening, because emergence across a network *is*
 * the product. No display hero, no global CTA card, rail-titled bands as the
 * divider language.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GroupCard from '../components/groups/GroupCard.astro';
import GatheringCardCompact from '../components/meetups/GatheringCardCompact.astro';
import AtEventCard from '../components/meetups/AtEventCard.astro';
import DrawnUnderline from '../components/marks/DrawnUnderline.astro';
import { isCancelled } from '../lib/at-events';
import { getCategoryLabel } from '../lib/categories';
import {
  db, Groups, Meetups, RSVPs, AtEvents, AtEventMeta, AtGroups,
  count, eq, and, gte, asc, desc, inArray,
} from 'astro:db';

const today = new Date();
today.setHours(0, 0, 0, 0);

const activeGroups = await db.select().from(Groups).where(eq(Groups.status, 'active'));
const groupMap = new Map(activeGroups.map((g) => [g.id, g]));
const activeGroupIds = new Set(activeGroups.map((g) => g.id));

const allUpcoming = await db
  .select()
  .from(Meetups)
  .where(and(eq(Meetups.status, 'active'), gte(Meetups.date, today)))
  .orderBy(asc(Meetups.date))
  .limit(24);

const upcomingGatherings = allUpcoming.filter((m) => activeGroupIds.has(m.groupId)).slice(0, 6);

const meetupIds = upcomingGatherings.map((m) => m.id);
const rsvpRows = meetupIds.length
  ? await db.select({ meetupId: RSVPs.meetupId, val: count() })
      .from(RSVPs).where(inArray(RSVPs.meetupId, meetupIds)).groupBy(RSVPs.meetupId)
  : [];
const rsvpCounts: Record<string, number> = Object.fromEntries(rsvpRows.map((r) => [r.meetupId, r.val]));

const featuredGroups = await db
  .select().from(Groups).where(eq(Groups.status, 'active'))
  .orderBy(desc(Groups.createdAt)).limit(4);

// Events from the rest of the network — the rail that makes the point.
const localAtEventUriSet = new Set(allUpcoming.filter((m) => m.atEventUri).map((m) => m.atEventUri!));
const todayIso = today.toISOString();
const rawExternalEvents = await db
  .select({
    uri: AtEvents.uri, did: AtEvents.did, name: AtEvents.name,
    startsAt: AtEvents.startsAt, locationJson: AtEvents.locationJson,
    urisJson: AtEvents.urisJson, status: AtEvents.status, groupName: AtGroups.name,
  })
  .from(AtEvents)
  .leftJoin(AtEventMeta, eq(AtEventMeta.eventUri, AtEvents.uri))
  .leftJoin(AtGroups, eq(AtGroups.uri, AtEventMeta.groupUri))
  // Only events that are actually about tech — the calendar lexicon is
  // shared by the whole Atmosphere.
  .where(and(gte(AtEvents.startsAt, todayIso), eq(AtEvents.topical, true)))
  .orderBy(asc(AtEvents.startsAt))
  .limit(12);
const seenUris = new Set<string>();
const externalEvents = rawExternalEvents
  .filter((e) => {
    if (seenUris.has(e.uri)) return false;
    seenUris.add(e.uri);
    if (isCancelled(e.status)) return false;
    return !localAtEventUriSet.has(e.uri);
  })
  .slice(0, 3);

const featuredGroupIds = featuredGroups.map((g) => g.id);
const upcomingRows = featuredGroupIds.length
  ? await db.select({ groupId: Meetups.groupId, val: count() })
      .from(Meetups)
      .where(and(inArray(Meetups.groupId, featuredGroupIds), gte(Meetups.date, today)))
      .groupBy(Meetups.groupId)
  : [];
const upcomingCounts: Record<string, number> = Object.fromEntries(upcomingRows.map((r) => [r.groupId, r.val]));

// Discovery cuts — an index earns its name by offering more than one way in.
const cityTally = new Map<string, number>();
for (const g of activeGroups) {
  if (!g.city) continue;
  cityTally.set(g.city, (cityTally.get(g.city) ?? 0) + 1);
}
const cities = [...cityTally.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);

const categoryTally = new Map<string, number>();
for (const g of activeGroups) {
  if (!g.category) continue;
  categoryTally.set(g.category, (categoryTally.get(g.category) ?? 0) + 1);
}
const categories = [...categoryTally.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 12);
---

<BaseLayout title="Local tech groups worth showing up to">
  {/* Positioning paragraph — Ecosystem Index opens with a statement, not a display hero. */}
  <section class="lede reveal" style="--i: 0">
    <div class="container">
      <p class="lede-text">
        Most tech work happens in front of a screen, for people you&rsquo;ll never
        meet. Here are the times it doesn&rsquo;t &mdash; local groups, real rooms,
        and <span class="marked">people worth the trip<DrawnUnderline tone="sun" variant={1} /></span>.
      </p>
      <p class="lede-note">
        Every corner of tech: web and mobile, data and AI, platform and security, game
        dev, design systems, indie projects, developer relations. What these groups have
        in common isn&rsquo;t a subject &mdash; it&rsquo;s that they&rsquo;re built for
        turning up on your own and leaving glad you did.
        <a href="/code-of-conduct">That&rsquo;s the one thing we ask of them</a>.
      </p>
    </div>
  </section>

  {/* Rail 1 — what's on */}
  <section class="band reveal" style="--i: 1">
    <div class="container">
      <div class="rail">
        <h2 class="rail-title">Coming up</h2>
        <span class="rail-meta">
          {upcomingGatherings.length} upcoming {upcomingGatherings.length === 1 ? 'gathering' : 'gatherings'}
        </span>
        <a href="/gatherings" class="rail-more">All gatherings &rarr;</a>
      </div>

      {upcomingGatherings.length === 0 ? (
        <p class="rail-empty">
          Nothing on the calendar yet. <a href="/groups/register">Start a group</a> and
          put the first one up &mdash; someone nearby is waiting for exactly this.
        </p>
      ) : (
        <div class="grid-3">
          {upcomingGatherings.map((m) => {
            const group = groupMap.get(m.groupId)!;
            return (
              <GatheringCardCompact
                id={m.id} title={m.title} date={m.date} time={m.time}
                venue={m.venue} address={m.address} city={m.city} country={m.country}
                eventContext={m.eventContext} capacity={m.capacity}
                rsvpCount={rsvpCounts[m.id] ?? 0} groupName={group.name}
              />
            );
          })}
        </div>
      )}
    </div>
  </section>

  {/* Rail 2 — the rest of the network. Always renders: this rail IS the
      interoperability argument, and it makes that argument whether or not
      the indexer has caught anything yet. */}
  <section class="band reveal" style="--i: 2">
    <div class="container">
      <div class="rail">
        <h2 class="rail-title">Elsewhere in the Atmosphere</h2>
        <span class="rail-meta ident">community.lexicon.calendar.event</span>
        {externalEvents.length > 0 && <a href="/gatherings" class="rail-more">Browse the network &rarr;</a>}
      </div>

      {externalEvents.length > 0 ? (
        <>
          <p class="rail-lede">
            Put up by people using other apps &mdash; Smoke Signal, atmo.rsvp, OpenMeet
            &mdash; and visible here because we all speak the same schema. Nobody had to
            integrate with anybody. Go anyway.
          </p>
          <div class="grid-3">
            {externalEvents.map((e) => (
              <AtEventCard
                uri={e.uri} did={e.did} name={e.name} startsAt={e.startsAt}
                locationJson={e.locationJson ?? null} urisJson={e.urisJson ?? null}
                status={e.status ?? null} groupName={e.groupName ?? null}
              />
            ))}
          </div>
        </>
      ) : (
        <div class="network-note">
          <p class="network-note-lead">
            DevRel(ish) doesn&rsquo;t only show its own events. Tech events published
            anywhere on the AT&nbsp;Protocol as a <span class="ident">calendar.event</span>
            turn up here too &mdash; from <a href="https://smokesignal.events" target="_blank" rel="noopener noreferrer">Smoke&nbsp;Signal</a>,
            <a href="https://atmo.rsvp" target="_blank" rel="noopener noreferrer">atmo.rsvp</a>,
            <a href="https://openmeet.net" target="_blank" rel="noopener noreferrer">OpenMeet</a>,
            or anything built next week.
          </p>
          <p class="network-note-body">
            Nobody had to integrate with anybody; we just write the same records. It works
            in reverse too: post a gathering here and it appears in those apps, on your own
            account, whether or not this site is still around.
            <a href="/how-it-works">How that works &rarr;</a>
          </p>
          <p class="network-note-status">
            Nothing to show yet. That schema is shared with the rest of the Atmosphere
            &mdash; book clubs, yoga, everything &mdash; so we only surface the events
            about technology, and there aren&rsquo;t any on the calendar right now.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* Rail 3 — groups */}
  {featuredGroups.length > 0 && (
    <section class="band reveal" style="--i: 3">
      <div class="container">
        <div class="rail">
          <h2 class="rail-title">Groups</h2>
          <span class="rail-meta">
            {activeGroups.length} active {activeGroups.length === 1 ? 'community' : 'communities'}
          </span>
          <a href="/groups" class="rail-more">All groups &rarr;</a>
        </div>
        <div class="grid-4">
          {featuredGroups.map((g) => (
            <GroupCard
              id={g.id} name={g.name} slug={g.slug} customSlug={g.customSlug}
              city={g.city} region={g.region} country={g.country}
              tagline={g.tagline} category={g.category} tags={g.tags}
              description={g.description} upcomingCount={upcomingCounts[g.id]}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Rail 4 — browse cuts */}
  {(cities.length > 0 || categories.length > 0) && (
    <section class="band reveal" style="--i: 4">
      <div class="container">
        <div class="rail">
          <h2 class="rail-title">Find your corner</h2>
          <span class="rail-meta">by city, or by what you&rsquo;re into</span>
        </div>
        <div class="cuts">
          {cities.length > 0 && (
            <div class="cut">
              <h3 class="cut-head">By city</h3>
              <ul class="cut-list" role="list">
                {cities.map(([city, n]) => (
                  <li>
                    <a href={`/groups?city=${encodeURIComponent(city)}`}>
                      <span class="cut-name">{city}</span>
                      <span class="cut-count">{n}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {categories.length > 0 && (
            <div class="cut">
              <h3 class="cut-head">By what you&rsquo;re into</h3>
              <ul class="cut-list" role="list">
                {categories.map(([slug, n]) => (
                  <li>
                    <a href={`/groups?category=${encodeURIComponent(slug)}`}>
                      <span class="cut-name">{getCategoryLabel(slug) ?? slug}</span>
                      <span class="cut-count">{n}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {/* Closing note — an aside, not a CTA card. */}
  <section class="band closing reveal" style="--i: 5">
    <div class="container">
      <div class="rail">
        <h2 class="rail-title">Thinking of starting one?</h2>
      </div>
      <div class="closing-body">
        <p>
          Register a group and it&rsquo;s live immediately &mdash; no approval queue, no
          review. We ask one thing: that you run something people can turn up to on their
          own and be glad they did, and that you act when someone tells you it
          isn&rsquo;t. That&rsquo;s the <a href="/code-of-conduct">code of conduct</a>, in
          a sentence. Your group and every gathering become records on your own account,
          so they surface in other Atmosphere apps too, and stay yours if you ever stop
          using this one. Already running events elsewhere? Bring them across in a couple
          of clicks.
        </p>
        <div class="closing-actions">
          <span class="marked marked-btn">
            <a href="/groups/register" class="btn btn-primary">Start a group</a>
            <DrawnUnderline tone="accent" variant={2} />
          </span>
          <a href="/how-it-works" class="btn btn-quiet">How it works</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Lede ─────────────────────────────────────────────────────────────── */
  .lede {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-lg);
  }

  .lede-text {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-weight: 400;
    font-size: clamp(1.375rem, 3.2vw, 2rem);
    line-height: 1.32;
    letter-spacing: -0.015em;
    max-width: 36ch;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .lede-text .marked {
    white-space: normal;
  }

  .marked-btn {
    display: inline-block;
    position: relative;
  }

  .lede-note {
    margin-top: var(--space-md);
    max-width: 58ch;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    padding-left: var(--space-sm);
    border-left: var(--rule-thin) solid var(--color-rule-strong);
  }

  .lede-note em { font-style: italic; }

  /* ── Bands · varied rhythm, deliberately not one repeated padding ─────── */
  .band { padding-block: var(--space-lg); }
  .band:nth-of-type(even) { padding-block: var(--space-xl) var(--space-lg); }
  .closing { padding-top: var(--space-xl); padding-bottom: var(--space-lg); }

  .rail-lede {
    margin-top: calc(var(--space-2xs) * -1);
    margin-bottom: var(--space-md);
    max-width: 62ch;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .network-note {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-md);
    background: var(--color-sun-wash);
    border-radius: var(--radius-md);
  }

  .network-note-lead {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1.4;
    max-width: 62ch;
  }

  .network-note-body {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: 62ch;
  }

  .network-note-status {
    font-size: var(--text-xs);
    color: var(--color-muted);
    max-width: none;
  }

  .rail-empty {
    font-size: var(--text-sm);
    color: var(--color-muted);
    padding: var(--space-md) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    max-width: none;
  }

  /* minmax(0, 1fr) — a bare 1fr lets content force horizontal overflow */
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  /* ── Browse cuts ──────────────────────────────────────────────────────── */
  .cuts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .cut-head {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink-2);
    margin-bottom: var(--space-2xs);
  }

  .cut-list {
    list-style: none;
    columns: 2;
    column-gap: var(--space-md);
  }

  .cut-list li { break-inside: avoid; }

  .cut-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding-block: 0.3rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    text-decoration: none;
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .cut-list a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .cut-name { min-width: 0; overflow-wrap: anywhere; }

  .cut-count {
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  /* ── Closing ──────────────────────────────────────────────────────────── */
  .closing-body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .closing-body p {
    max-width: var(--measure);
    color: var(--color-ink-2);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 60rem) {
    .grid-3, .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .closing-body { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
  }

  @media (max-width: 40rem) {
    .grid-3, .grid-4 { grid-template-columns: minmax(0, 1fr); }
    .cuts { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .cut-list { columns: 1; }
    .lede-text { max-width: none; }
  }
</style>
