---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { db, Groups, Meetups, Followers, AppUser, count, eq, and, gte, asc } from "astro:db";
import { groupUrl } from "../../lib/utils";

if (!Astro.locals.user) return Astro.redirect("/auth/login");
const user = Astro.locals.user;
const justJoined = Astro.url.searchParams.get("joined") === "1";
const justPublished = Astro.url.searchParams.get("published") === "atproto";
const publishError = Astro.url.searchParams.get("error") === "publish-failed";
const publisherConnected = Astro.url.searchParams.get("publisher") === "connected";
const publisherError = Astro.url.searchParams.get("error");

// Find the user's group — check by stored groupId first, fall back to managerId
// (handles accounts created before Phase 4 linked group ↔ user)
let [group] = user.groupId
  ? await db.select().from(Groups).where(eq(Groups.id, user.groupId))
  : [];

if (!group) {
  const [byManager] = await db
    .select()
    .from(Groups)
    .where(eq(Groups.managerId, user.did));
  if (byManager) {
    group = byManager;
    // Heal the missing link so future loads skip this fallback
    await db.update(AppUser).set({ groupId: byManager.id }).where(eq(AppUser.did, user.did));
  }
}

const today = new Date();
today.setHours(0, 0, 0, 0);

let upcomingMeetups: typeof Meetups.$inferSelect[] = [];
let followerCount = 0;

if (group) {
  upcomingMeetups = await db
    .select()
    .from(Meetups)
    .where(and(eq(Meetups.groupId, group.id), gte(Meetups.date, today)))
    .orderBy(asc(Meetups.date))
    .limit(3);

  const [fr] = await db
    .select({ val: count() })
    .from(Followers)
    .where(and(eq(Followers.groupId, group.id), eq(Followers.confirmed, true)));
  followerCount = fr?.val ?? 0;
}
---

<DashboardLayout title="Dashboard">
  <div class="dash-page">
    <div class="dash-page-header">
      <h1>Hello, {user.displayName?.split(" ")[0] ?? user.handle}</h1>
    </div>

    {justJoined && (
      <div class="alert alert-success" style="margin-bottom: 1.5rem;">
        Welcome to the team! You now have organizer access to your group.
      </div>
    )}

    {justPublished && (
      <div class="alert alert-success" style="margin-bottom: 1.5rem;">
        Your group is now published to the ATProto network. Members can now join and RSVPs will sync.
      </div>
    )}

    {publishError && (
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        Could not publish to ATProto. Please try again or check that your session is still active.
      </div>
    )}

    {publisherConnected && (
      <div class="alert alert-success" style="margin-bottom: 1.5rem;">
        Group publisher account connected. You can now publish the group and its public records from that account.
      </div>
    )}

    {publisherError === "publisher-must-be-separate" && (
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        Use a dedicated group account, not your personal organizer account, to publish this group.
      </div>
    )}

    {(publisherError === "publisher-reauthorize" || publisherError === "publisher-authorization") && (
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        The group publisher account needs to be connected again before it can publish records.
      </div>
    )}

    {
      !group ? (
        <div class="no-group-state">
          <div class="no-group-card">
            <div class="state-icon" aria-hidden="true">◎</div>
            <h2>No group yet</h2>
            <p>
              You haven't started a group yet. Create one to start organizing
              gatherings for your community — it goes live instantly.
            </p>
            <a href="/groups/register" class="btn btn-primary" style="margin-top: 0.5rem;">
              Start a group →
            </a>
            <p style="margin-top: 1rem; font-size: var(--text-sm); color: var(--color-ink-2);">
              Already have a group? Ask the group admin to send you a co-organizer invite.
            </p>
          </div>
        </div>
      ) : (
        <div class="dash-overview">
          <div class="overview-header">
            <div>
              <h2 class="group-title">{group.name}</h2>
              <p class="group-location">
                {group.region ? `${group.city}, ${group.region}` : `${group.city}, ${group.country}`}
              </p>
            </div>
            <a href={groupUrl(group)} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
              View public page ↗
            </a>
          </div>

          {!group.publisherDid && (
            <div class="atproto-nudge">
              <div class="atproto-nudge-text">
                <strong>Connect a group publisher account</strong>
                <span>Use a dedicated ATProto account for the group’s public records. Your personal organizer account stays separate.</span>
              </div>
              <form method="POST" action="/api/groups/connect-publisher">
                <button type="submit" class="btn btn-primary btn-sm">
                  Connect group account →
                </button>
              </form>
            </div>
          )}

          {group.publisherDid && !group.atUri && (
            <div class="atproto-nudge">
              <div class="atproto-nudge-text">
                <strong>Ready to publish</strong>
                <span>Your dedicated group account is connected. Publish the group record to make it discoverable in the Atmosphere.</span>
              </div>
              <form method="POST" action="/api/groups/publish-atproto">
                <button type="submit" class="btn btn-primary btn-sm">Publish to ATProto →</button>
              </form>
            </div>
          )}

          <div class="stat-cards">
            <div class="stat-card">
              <div class="stat-value">{upcomingMeetups.length}</div>
              <div class="stat-label">Upcoming gatherings</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">{followerCount}</div>
              <div class="stat-label">Followers</div>
            </div>
            <a href="/dashboard/gatherings/new" class="stat-card stat-card-cta">
              <div class="stat-cta-icon" aria-hidden="true">+</div>
              <div class="stat-label">Schedule a gathering</div>
            </a>
          </div>

          {upcomingMeetups.length > 0 && (
            <div class="upcoming-meetups">
              <div class="section-row">
                <h3>Upcoming gatherings</h3>
                <a href="/dashboard/gatherings" class="link-sm">View all →</a>
              </div>
              <div class="meetup-list">
                {upcomingMeetups.map((m) => (
                  <div class="meetup-row">
                    <div class="meetup-date-mini">
                      <span>{new Intl.DateTimeFormat("en-US", { month: "short" }).format(m.date)}</span>
                      <strong>{m.date.getDate()}</strong>
                    </div>
                    <div class="meetup-row-info">
                      <span class="meetup-row-title">{m.title}</span>
                      <span class="meetup-row-venue">{m.venue}</span>
                    </div>
                    <div class="meetup-row-actions">
                      <a href={`/dashboard/gatherings/${m.id}/attendees`} class="btn btn-ghost btn-sm">
                        Attendees
                      </a>
                      <a href={`/dashboard/gatherings/${m.id}/speakers`} class="btn btn-ghost btn-sm">
                        Speakers
                      </a>
                      <a href={`/dashboard/gatherings/${m.id}/edit`} class="btn btn-ghost btn-sm">
                        Edit
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )
    }
  </div>
</DashboardLayout>

<style>
  .dash-page-header {
    margin-bottom: 2rem;
  }

  .dash-page-header h1 {
    font-size: var(--text-3xl);
  }

  /* No group state */
  .no-group-state {
    display: flex;
    justify-content: center;
  }

  .no-group-card {
    max-width: 480px;
    text-align: center;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 2.5rem;
  }

  .state-icon {
    font-size: 3rem;
    color: var(--color-accent);
    opacity: 0.4;
    margin-bottom: 1rem;
  }

  .no-group-card h2 {
    margin-bottom: 0.75rem;
    font-size: var(--text-xl);
  }

  .no-group-card p {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    margin-bottom: 0.75rem;
    max-width: none;
  }

  /* Overview */
  .overview-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .group-title {
    font-size: var(--text-2xl);
  }

  .group-location {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin-top: 0.25rem;
    max-width: none;
  }

  .stat-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    text-align: center;
  }

  .stat-card-cta {
    background: var(--color-paper-2);
    border-color: var(--color-accent);
    text-decoration: none;
    transition: transform var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out);
    display: block;
  }

  .stat-card-cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.375rem;
  }

  .stat-cta-icon {
    font-size: var(--text-4xl);
    color: var(--color-accent);
    font-family: var(--font-display);
    line-height: 1;
    margin-bottom: 0.375rem;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    font-weight: 600;
  }

  /* Meetups list */
  .section-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .section-row h3 {
    font-size: var(--text-lg);
  }

  .link-sm {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .meetup-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meetup-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    flex-wrap: wrap;
  }

  .meetup-date-mini {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    min-width: 40px;
    font-size: var(--text-xs);
    flex-shrink: 0;
  }

  .meetup-date-mini strong {
    font-size: var(--text-lg);
    line-height: 1;
    font-family: var(--font-display);
  }

  .meetup-row-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .meetup-row-title {
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .meetup-row-venue {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .meetup-row-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .atproto-nudge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-paper));
    border: var(--rule-hair) solid var(--color-accent-wash);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .atproto-nudge-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--text-sm);
  }

  .atproto-nudge-text strong {
    color: var(--color-ink);
  }

  .atproto-nudge-text span {
    color: var(--color-ink-2);
  }
</style>
