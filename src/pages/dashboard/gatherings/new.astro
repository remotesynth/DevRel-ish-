---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { db, Groups, Meetups, Followers, eq, and } from "astro:db";
import { generateId } from "../../../lib/utils";
import { sendGatheringNotification } from "../../../lib/email";
import { publishGathering, resolveCapacity, resolveLocation } from "../../../lib/gatherings";

if (!Astro.locals.user) return Astro.redirect("/auth/login");
const user = Astro.locals.user;

const [group] = user.groupId
  ? await db.select().from(Groups).where(eq(Groups.id, user.groupId))
  : [];

if (!group) return Astro.redirect("/dashboard");

type FormError = { type: "error"; message: string };
let error: FormError | null = null;

// Preserve form values on validation failure
let vals = {
  title: "",
  description: "",
  date: "",
  time: "18:00",
  endTime: "",
  mode: "inperson",
  venue: "",
  joinUrl: "",
  address: "",
  city: "",
  country: "",
  eventContext: "",
  tags: "",
  capacity: "30",
};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  vals = {
    title: form.get("title")?.toString().trim() ?? "",
    description: form.get("description")?.toString().trim() ?? "",
    date: form.get("date")?.toString() ?? "",
    time: form.get("time")?.toString() ?? "18:00",
    endTime: form.get("endTime")?.toString() ?? "",
    mode: form.get("mode")?.toString() ?? "inperson",
    venue: form.get("venue")?.toString().trim() ?? "",
    joinUrl: form.get("joinUrl")?.toString().trim() ?? "",
    address: form.get("address")?.toString().trim() ?? "",
    city: form.get("city")?.toString().trim() ?? "",
    country: form.get("country")?.toString().trim() ?? "",
    eventContext: form.get("eventContext")?.toString().trim() ?? "",
    tags: form.get("tags")?.toString().trim() ?? "",
    capacity: form.get("capacity")?.toString() ?? "30",
  };

  const meetupDate = new Date(vals.date);
  const where = resolveLocation(vals);
  const cap = resolveCapacity(vals.capacity);

  if (!vals.title || !vals.description || !vals.date || !vals.time) {
    error = { type: "error", message: "All required fields must be filled in." };
  } else if (vals.description.length < 20) {
    error = { type: "error", message: "Description must be at least 20 characters." };
  } else if (isNaN(meetupDate.getTime())) {
    error = { type: "error", message: "Invalid date." };
  } else if (meetupDate < new Date()) {
    error = { type: "error", message: "Gathering date must be in the future." };
  } else if ("error" in where) {
    error = { type: "error", message: where.error };
  } else if ("error" in cap) {
    error = { type: "error", message: cap.error };
  } else {
    const newId = generateId();
    await db.insert(Meetups).values({
      id: newId,
      groupId: group.id,
      title: vals.title,
      description: vals.description,
      date: meetupDate,
      time: vals.time,
      endTime: vals.endTime || null,
      mode: where.mode,
      venue: where.venue,
      joinUrl: where.joinUrl,
      address: where.address,
      city: vals.city || null,
      country: vals.country || null,
      eventContext: vals.eventContext || null,
      tags: vals.tags || null,
      capacity: cap.capacity,
      createdAt: new Date(),
    });

    // Publish to the organizer's PDS so the gathering exists on the network,
    // not just in our database. Best-effort — never blocks the redirect.
    const [saved] = await db.select().from(Meetups).where(eq(Meetups.id, newId));
    if (saved) await publishGathering(saved, group);

    // Notify confirmed followers (fire-and-forget — don't block the redirect)
    const followers = await db
      .select()
      .from(Followers)
      .where(and(eq(Followers.groupId, group.id), eq(Followers.confirmed, true)));

    if (followers.length > 0) {
      sendGatheringNotification({
        followers: followers.map(f => ({ email: f.email, name: f.name, token: f.token })),
        group: { name: group.name, slug: group.slug },
        gathering: {
          title: vals.title,
          date: meetupDate,
          time: vals.time,
          mode: where.mode,
          venue: where.venue,
          city: vals.city || null,
          country: vals.country || null,
          eventContext: vals.eventContext || null,
        },
        rsvpUrl: `${Astro.url.origin}/gatherings/${newId}/rsvp`,
      }).catch(e => console.error("[gathering notify] email error:", e));
    }

    return Astro.redirect("/dashboard/gatherings?created=1");
  }
}
---

<DashboardLayout title="New Gathering">
  <div class="page-header">
    <a href="/dashboard/gatherings" class="back-link">← Back to gatherings</a>
    <h1>Schedule a gathering</h1>
    <p>Fill in the details for your next gathering. Migrating from Meetup? <a href="/dashboard/gatherings/import" class="import-hint">Import events instead →</a></p>
  </div>

  <div class="form-wrap">
    <form method="POST" class="meetup-form">
      {error && (
        <div class="alert alert-error" role="alert">{error.message}</div>
      )}

      <div class="form-group">
        <label for="title">Gathering title *</label>
        <input id="title" name="title" type="text" value={vals.title} placeholder="Spring Social Gathering" required maxlength="100" />
      </div>

      <div class="form-group">
        <label for="description">Description *</label>
        <textarea id="description" name="description" rows="5" placeholder="What will you do? What's the vibe? Who should come?" required minlength="20" maxlength="2000">{vals.description}</textarea>
        <span class="form-hint">Markdown supported: **bold**, *italic*, # headings, - lists, [links](url).</span>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="date">Date *</label>
          <input id="date" name="date" type="date" value={vals.date} required min={new Date().toISOString().split("T")[0]} />
        </div>
        <div class="form-group">
          <label for="time">Start time *</label>
          <input id="time" name="time" type="time" value={vals.time} required />
        </div>
        <div class="form-group">
          <label for="endTime">End time</label>
          <input id="endTime" name="endTime" type="time" value={vals.endTime} />
          <span class="form-hint">Optional — but calendar apps across the Atmosphere render your event better with one.</span>
        </div>
      </div>

      <fieldset class="form-group mode-picker">
        <legend>Where is it?</legend>
        <div class="mode-options">
          <label class="mode-option">
            <input type="radio" name="mode" value="inperson" checked={vals.mode === "inperson"} />
            <span><strong>In person</strong><small>At a venue</small></span>
          </label>
          <label class="mode-option">
            <input type="radio" name="mode" value="virtual" checked={vals.mode === "virtual"} />
            <span><strong>Online</strong><small>A call or stream</small></span>
          </label>
          <label class="mode-option">
            <input type="radio" name="mode" value="hybrid" checked={vals.mode === "hybrid"} />
            <span><strong>Both</strong><small>Venue and a link</small></span>
          </label>
        </div>
      </fieldset>

      <div class="form-group venue-field">
        <label for="venue">Venue name *</label>
        <input id="venue" name="venue" type="text" value={vals.venue} placeholder="The Interval at Long Now" />
      </div>

      <div class="form-group venue-field">
        <label for="address">Address</label>
        <input id="address" name="address" type="text" value={vals.address} placeholder="2 Marina Blvd, San Francisco, CA 94123" />
      </div>

      <div class="form-group join-field">
        <label for="joinUrl">Joining link *</label>
        <input id="joinUrl" name="joinUrl" type="url" value={vals.joinUrl} placeholder="https://meet.example.com/your-room" />
        <span class="form-hint">
          Shown only to people who have RSVP'd, on the gathering page.
          It is never published to your public page or to the ATProto record.
        </span>
      </div>

      <div class="form-row venue-field">
        <div class="form-group">
          <label for="city">City</label>
          <input id="city" name="city" type="text" value={vals.city} placeholder="San Francisco" />
        </div>
        <div class="form-group">
          <label for="country">Country</label>
          <input id="country" name="country" type="text" value={vals.country} placeholder="USA" />
        </div>
      </div>

      <div class="form-group">
        <label for="eventContext">Event context</label>
        <input id="eventContext" name="eventContext" type="text" value={vals.eventContext} placeholder="KubeCon EU 2026" />
        <span class="form-hint">If this gathering is tied to a conference or larger event, name it here.</span>
      </div>

      <div class="form-group">
        <label for="tags">Tags</label>
        <input id="tags" name="tags" type="text" value={vals.tags} placeholder="community, enterprise" />
        <span class="form-hint">Comma-separated. Helps people discover this gathering.</span>
      </div>

      <div class="form-group">
        <label for="capacity">Capacity</label>
        <input id="capacity" name="capacity" type="number" value={vals.capacity} min="1" max="500" placeholder="Leave blank for unlimited" />
        <span class="form-hint">How many people can attend? Leave blank for no limit.</span>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create gathering →</button>
        <a href="/dashboard/gatherings" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</DashboardLayout>

<script>
  // Show only the fields the chosen mode actually needs. The server revalidates
  // in resolveLocation() — this is just so organizers aren't asked for a street
  // address for a video call.
  function syncModeFields(form: HTMLFormElement) {
    const mode = (form.querySelector('input[name="mode"]:checked') as HTMLInputElement | null)?.value ?? "inperson";
    const inPerson = mode !== "virtual";
    const online = mode !== "inperson";

    form.querySelectorAll<HTMLElement>(".venue-field").forEach(el => {
      el.hidden = !inPerson;
    });
    form.querySelectorAll<HTMLElement>(".join-field").forEach(el => {
      el.hidden = !online;
    });

    const venue = form.querySelector<HTMLInputElement>("#venue");
    if (venue) venue.required = inPerson;
    const joinUrl = form.querySelector<HTMLInputElement>("#joinUrl");
    if (joinUrl) joinUrl.required = online;
  }

  document.querySelectorAll<HTMLFormElement>("form.meetup-form").forEach(form => {
    form.querySelectorAll('input[name="mode"]').forEach(radio => {
      radio.addEventListener("change", () => syncModeFields(form));
    });
    syncModeFields(form);
  });
</script>

<style>
  .page-header {
    margin-bottom: 1.75rem;
  }

  .back-link {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink-2);
    display: block;
    margin-bottom: 0.75rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .import-hint {
    color: var(--color-ink-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .import-hint:hover {
    color: var(--color-accent);
    text-decoration-style: solid;
  }

  .page-header h1 {
    font-size: var(--text-3xl);
    margin-bottom: 0.25rem;
  }

  .page-header p {
    color: var(--color-ink-2);
  }

  .form-wrap .meetup-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
    max-width: 600px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-actions {
    display: flex;
    gap: 0.875rem;
    align-items: center;
  }

  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .mode-picker {
    border: none;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .mode-picker legend {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.5rem;
    padding: 0;
  }

  .mode-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .mode-option {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
    font-weight: 400;
  }

  .mode-option:hover {
    border-color: var(--color-accent);
  }

  .mode-option:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-wash, transparent);
  }

  .mode-option span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .mode-option strong {
    font-size: var(--text-sm);
  }

  .mode-option small {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
  }

  .venue-field[hidden],
  .join-field[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .mode-options {
      grid-template-columns: 1fr;
    }
  }
</style>
