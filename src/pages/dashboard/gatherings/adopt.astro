---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import AdoptEventsForm from '../../../components/meetups/AdoptEventsForm';
import { db, Groups } from 'astro:db';
import { eq } from 'astro:db';

if (!Astro.locals.user) return Astro.redirect('/auth/login');
const user = Astro.locals.user;

const [group] = user.groupId
  ? await db.select().from(Groups).where(eq(Groups.id, user.groupId))
  : [];

if (!group) return Astro.redirect('/dashboard');
---

<DashboardLayout title="Bring your existing events">
  <div class="page-header">
    <a href="/dashboard/gatherings" class="back-link">← Back to gatherings</a>
    <h1>Bring your existing events</h1>
    <p class="page-subtitle">
      Events you've already created on Smoke Signal, atmo.rsvp, OpenMeet, or any other
      Atmosphere calendar app live in <strong>your own account</strong> — not theirs.
      DevRel(ish) can read them straight from there and show them under
      <strong>{group.name}</strong>.
    </p>
  </div>

  <div class="adopt-wrap">
    <AdoptEventsForm client:load />

    <div class="adopt-notice">
      <strong>Nothing is copied or moved.</strong> Your event records stay exactly where
      they are, keeping their original <code>at://</code> address. DevRel(ish) adds a link
      saying "this event belongs to {group.name}" and leaves the rest alone — which also
      means edits you make in the original app keep working, and edits here won't overwrite
      them.
    </div>
  </div>
</DashboardLayout>

<style>
  .page-header { margin-bottom: 1.75rem; }

  .back-link {
    display: inline-block;
    font-size: var(--size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .back-link:hover { color: var(--color-primary); }

  .page-subtitle {
    color: var(--color-text-muted);
    font-size: var(--size-sm);
    margin-top: 0.375rem;
  }

  .adopt-wrap { max-width: 720px; }

  .adopt-notice {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface-warm);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  /* ── AdoptEventsForm styles ── */
  .adopt-form :global(.adopt-status) {
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    margin-block: 0.75rem;
  }

  .adopt-wrap :global(.adopt-empty) {
    padding: 1.25rem;
    background: var(--color-surface);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  .adopt-wrap :global(.adopt-list) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .adopt-wrap :global(.adopt-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .adopt-wrap :global(.adopt-item:hover) {
    border-color: var(--color-border-strong);
  }

  .adopt-wrap :global(.adopt-item input[type="checkbox"]) {
    margin-top: 0.25rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--color-primary);
    flex-shrink: 0;
  }

  .adopt-wrap :global(.adopt-item-body) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .adopt-wrap :global(.adopt-item-name) {
    font-size: var(--size-base);
    line-height: 1.3;
  }

  .adopt-wrap :global(.adopt-item-meta) {
    font-size: var(--size-xs);
    color: var(--color-text-muted);
  }

  .adopt-wrap :global(.adopt-flag) {
    font-size: var(--size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: oklch(45% 0.18 25);
  }

  .adopt-wrap :global(.adopt-flag.muted) {
    color: var(--color-text-light);
  }

  .adopt-wrap :global(.adopt-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .adopt-wrap :global(.adopt-note) {
    font-size: var(--size-xs);
    color: var(--color-text-muted);
  }

  .adopt-wrap :global(.adopt-fail-list) {
    margin: 0.375rem 0 0;
    padding-left: 1.125rem;
    font-weight: 400;
  }

  .adopt-wrap :global(.adopt-paste) {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 2px dashed var(--color-border);
  }

  .adopt-wrap :global(.adopt-paste h3) {
    font-size: var(--size-lg);
    margin-bottom: 0.375rem;
  }

  .adopt-wrap :global(.adopt-paste p) {
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .adopt-wrap :global(.adopt-paste-form) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .adopt-wrap :global(.adopt-paste-form input) {
    flex: 1 1 20rem;
  }

  .adopt-wrap :global(.adopt-done .adopt-actions) {
    margin-top: 1rem;
  }

  .adopt-wrap :global(.alert) {
    margin-bottom: 0.75rem;
  }
</style>
