---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db, Groups, AppUser } from "astro:db";
import { eq } from "astro:db";
import { generateId, slugify } from "../../lib/utils";
import { CATEGORIES, getCategoryLabel } from "../../lib/categories";
import { getPdsSession, pdsCreate } from "../../lib/atproto-pds";
import { buildAddress } from "../../lib/atproto-records";

if (!Astro.locals.user) {
  return Astro.redirect("/auth/login?redirect=/groups/register");
}
if (Astro.locals.user.groupId) {
  return Astro.redirect("/dashboard");
}

type Result =
  | { type: "success"; slug: string }
  | { type: "error"; message: string };

let result: Result | null = null;

let vals = {
  name: "", tagline: "", category: "", city: "", region: "", country: "", description: "", contactEmail: "",
};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const hp = form.get("_hp")?.toString() ?? "";
  const submittedAt = parseInt(form.get("_t")?.toString() ?? "0", 10);

  vals = {
    name:         form.get("name")?.toString().trim() ?? "",
    tagline:      form.get("tagline")?.toString().trim() ?? "",
    category:     form.get("category")?.toString().trim() ?? "",
    city:         form.get("city")?.toString().trim() ?? "",
    region:       form.get("region")?.toString().trim() ?? "",
    country:      form.get("country")?.toString().trim() ?? "",
    description:  form.get("description")?.toString().trim() ?? "",
    contactEmail: form.get("contactEmail")?.toString().trim().toLowerCase() ?? "",
  };

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const placeNameRe = /^[a-zA-ZÀ-ÿ\s\-'.,()]+$/;

  if (hp || !submittedAt || Date.now() - submittedAt < 3000) {
    result = { type: "success", slug: "" };
  } else if (!vals.name || !vals.description || !vals.contactEmail || !vals.category) {
    result = { type: "error", message: "Name, category, description, and contact email are required." };
  } else if (!CATEGORIES.find(c => c.slug === vals.category)) {
    result = { type: "error", message: "Please select a valid community category." };
  } else if (vals.description.length < 50) {
    result = { type: "error", message: "Description must be at least 50 characters." };
  } else if (!vals.description.includes(" ")) {
    result = { type: "error", message: "Please write a proper description for your group." };
  } else if (vals.city && !placeNameRe.test(vals.city)) {
    result = { type: "error", message: "Please enter a valid city name." };
  } else if (vals.region && !placeNameRe.test(vals.region)) {
    result = { type: "error", message: "Please enter a valid state or region name." };
  } else if (vals.country && !placeNameRe.test(vals.country)) {
    result = { type: "error", message: "Please enter a valid country name." };
  } else if (!emailRe.test(vals.contactEmail)) {
    result = { type: "error", message: "Please enter a valid email address." };
  } else {
    const [existing] = await db.select().from(Groups).where(eq(Groups.name, vals.name));
    if (existing) {
      result = { type: "error", message: "A group with that name already exists." };
    } else {
      let slug = slugify(vals.name);
      const [slugConflict] = await db.select().from(Groups).where(eq(Groups.slug, slug));
      if (slugConflict) slug = `${slug}-${Math.random().toString(36).slice(2, 6)}`;

      // Write com.devrelish.group record to the organizer's PDS
      const session = await getPdsSession(Astro.locals.user.did);
      if (!session) {
        result = { type: "error", message: "Authentication session expired. Please sign in again." };
      } else {
        let atUri: string | null = null;
        let atCid: string | null = null;
        const now = new Date();
        const groupId = generateId();

        try {
          const address = buildAddress({
            locality: vals.city,
            region: vals.region,
            country: vals.country,
          });
          const locationEntry = address ? { location: address } : {};

          const pdsResult = await pdsCreate(session, "com.devrelish.group", {
            name: vals.name,
            description: vals.description,
            category: vals.category,
            ...locationEntry,
            createdAt: now.toISOString(),
          });
          atUri = pdsResult.uri;
          atCid = pdsResult.cid;
        } catch (err) {
          console.error("[register] PDS write failed:", err);
          result = { type: "error", message: "Failed to publish group to ATProto network. Please try again." };
        }

        if (!result) {
          await db.insert(Groups).values({
            id: groupId,
            name: vals.name,
            slug,
            tagline: vals.tagline || null,
            category: vals.category,
            city: vals.city || null,
            region: vals.region || null,
            country: vals.country || null,
            description: vals.description,
            contactEmail: vals.contactEmail,
            status: "active",
            managerId: Astro.locals.user.did,
            atUri,
            atCid,
            createdAt: now,
          });
          await db.update(AppUser).set({ groupId }).where(eq(AppUser.did, Astro.locals.user.did));
          result = { type: "success", slug };
        }
      }
    }
  }
}
---

<BaseLayout
  title="Start a Group"
  description="Apply to start a group on DevRel(ish) for your niche technical community. We'll review your application and get back to you soon."
>
  <section class="page-hero">
    <div class="container">
      <div class="hero-eyebrow">✦ New group application</div>
      <h1>Start a group</h1>
      <p>
        Want to organize real-life gatherings for your community — in your city, at conferences, or wherever
        your people meet? Fill out this form and we'll get you set up.
      </p>
    </div>
  </section>

  <section class="form-section">
    <div class="container form-layout">
      <div class="form-main">
        {result?.type === "success" && result.slug ? (
          <div class="success-state">
            <div class="success-icon" aria-hidden="true">✦</div>
            <h2>Your group is live!</h2>
            <p>
              Your group has been created and published to the ATProto network.
            </p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center;margin-top:0.5rem;">
              <a href={`/groups/${result.slug}`} class="btn btn-primary">View your group →</a>
              <a href="/dashboard" class="btn btn-ghost">Go to dashboard</a>
            </div>
          </div>
        ) : (
          <form method="POST" class="group-form">
            <input name="_hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field" />
            <input name="_t" type="hidden" value={String(Date.now())} />
            {result?.type === "error" && (
              <div class="alert alert-error" role="alert">{result.message}</div>
            )}

            <div class="form-section-block">
              <h3 class="section-title">About your group</h3>

              <div class="form-group">
                <label for="name">Group name *</label>
                <input
                  id="name" name="name" type="text"
                  value={vals.name}
                  placeholder="DevRel(ish) SF, DevRel Connectors..."
                  required minlength="3" maxlength="80"
                />
                <span class="form-hint">
                  We'll turn it into a URL slug like <code>/groups/devrel-sf</code>.
                </span>
              </div>

              <div class="form-group">
                <label for="tagline">Tagline</label>
                <input
                  id="tagline" name="tagline" type="text"
                  value={vals.tagline}
                  placeholder="Connecting cloud-native practitioners at major tech events"
                  maxlength="120"
                />
                <span class="form-hint">One short sentence that describes what your group is about.</span>
              </div>

              <div class="form-group">
                <label for="category">Community category *</label>
                <select id="category" name="category" required>
                  <option value="" disabled selected={!vals.category}>Select a category…</option>
                  {CATEGORIES.map(c => (
                    <option value={c.slug} selected={vals.category === c.slug}>{c.label}</option>
                  ))}
                </select>
                <span class="form-hint">Choose the category that best describes your community.</span>
              </div>

              <div class="form-group">
                <label for="description">Description *</label>
                <textarea
                  id="description" name="description"
                  placeholder="Tell us about your group — who it's for, the vibe, what you'll do together..."
                  required minlength="50" maxlength="1000"
                  rows="5"
                >{vals.description}</textarea>
                <span class="form-hint">Markdown supported: **bold**, *italic*, # headings, - lists, [links](url).</span>
              </div>
            </div>

            <div class="form-section-block">
              <h3 class="section-title">Location <span class="optional-label">(optional)</span></h3>
              <p class="section-desc">If your group is tied to a city, fill this in. If you're event-based or distributed, leave it blank.</p>

              <div class="form-row">
                <div class="form-group">
                  <label for="city">City</label>
                  <input id="city" name="city" type="text" value={vals.city} placeholder="San Francisco" />
                </div>
                <div class="form-group">
                  <label for="region">State / Province</label>
                  <input id="region" name="region" type="text" value={vals.region} placeholder="CA" maxlength="50" />
                </div>
              </div>

              <div class="form-group">
                <label for="country">Country</label>
                <input id="country" name="country" type="text" value={vals.country} placeholder="USA" />
              </div>
            </div>

            <div class="form-section-block">
              <h3 class="section-title">Your contact info</h3>

              <div class="form-group">
                <label for="contactEmail">Email address *</label>
                <input
                  id="contactEmail" name="contactEmail" type="email"
                  value={vals.contactEmail}
                  placeholder="you@example.com"
                  required
                />
                <span class="form-hint">
                  Used for organizer notifications. Not displayed publicly.
                </span>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-lg">
                Create group →
              </button>
              <p class="form-hint">
                Your group goes live instantly and is published to the ATProto network.
              </p>
            </div>
          </form>
        )}
      </div>

      <aside class="form-sidebar">
        <div class="sidebar-card">
          <h3>What happens next</h3>
          <ol class="steps-list">
            <li>
              <span class="step-num">1</span>
              <div>
                <strong>Fill out this form</strong>
                <p>Takes about 2 minutes.</p>
              </div>
            </li>
            <li>
              <span class="step-num">2</span>
              <div>
                <strong>Your group goes live instantly</strong>
                <p>No approval queue — your group is published to the ATProto network right away.</p>
              </div>
            </li>
            <li>
              <span class="step-num">3</span>
              <div>
                <strong>Start creating gatherings</strong>
                <p>Head to your dashboard and schedule your first event!</p>
              </div>
            </li>
          </ol>
        </div>

        <div class="sidebar-card sidebar-card-warm">
          <h3>Who is (ish) for?</h3>
          <p>
            DevRel(ish) is built for niche technical communities — groups with a shared professional
            identity who want to meet in person. If your community fits one of our categories
            and gathers for genuine connection (not sales), you're a great fit.
          </p>
        </div>

        <div class="sidebar-card">
          <h3>Organizer data rules</h3>
          <p>
            By starting a group you agree to use attendee contact information only for organizing
            your group's events. Sharing, selling, or marketing to attendees outside of
            event-related communications is not permitted.
          </p>
          <a href="/privacy#organizer-rules" class="sidebar-link">Read the full organizer rules →</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .page-hero {
    padding: 3rem 0 2rem;
    background: var(--color-paper-2);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    background: var(--color-accent-wash);
    padding: 0.25rem 0.875rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }

  .page-hero h1 {
    margin-bottom: 0.75rem;
  }

  .page-hero p {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 56ch;
  }

  .form-section {
    padding: 2.5rem 0 4rem;
  }

  .form-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Form */
  .group-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-section-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .section-title {
    font-size: var(--text-lg);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: var(--rule-hair) dashed var(--color-rule);
  }

  .optional-label {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    font-family: var(--font-body);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin: 0;
    max-width: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Success */
  .success-state {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-ok);
    border-radius: var(--radius-sm);
  }

  .success-icon {
    font-size: 3rem;
    color: var(--color-ok);
    margin-bottom: 1rem;
    display: block;
  }

  .success-state h2 {
    margin-bottom: 0.75rem;
    color: var(--color-ok);
  }

  .success-state p {
    color: var(--color-ink-2);
    margin: 0 auto 0.75rem;
    max-width: 44ch;
  }

  /* Sidebar */
  .form-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: var(--space-lg);
  }

  .sidebar-card {
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .sidebar-card-warm {
    background: var(--color-paper-2);
    border-color: var(--color-rule-strong);
  }

  .sidebar-card h3 {
    font-size: var(--text-base);
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: var(--rule-hair) dashed var(--color-rule);
  }

  .sidebar-card p {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin-bottom: 0.5rem;
  }

  .sidebar-link {
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .steps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .steps-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .steps-list strong {
    display: block;
    font-size: var(--text-sm);
    margin-bottom: 0.125rem;
  }

  .steps-list p {
    font-size: var(--text-xs);
    margin: 0;
  }

  @media (max-width: 768px) {
    .form-layout {
      grid-template-columns: 1fr;
    }

    .form-sidebar {
      position: static;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
