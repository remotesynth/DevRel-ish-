---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="How It Works"
  description="Learn how DevRel(ish) works — from registering a group to hosting gatherings and growing your community."
>
  <div class="hiw-hero">
    <div class="hiw-hero-inner">
      <p class="hiw-eyebrow">Documentation</p>
      <h1>How DevRel(ish) Works</h1>
      <p class="hiw-lead">
        DevRel(ish) is a platform for developer relations professionals and adjacent roles to find and run in-person gatherings around the world.
        It's built on the open <a href="https://atproto.com" target="_blank" rel="noopener">AT Protocol</a> — the same decentralized standard that powers Bluesky —
        so your data is portable, your identity travels with you, and events are visible across compatible apps.
      </p>
      <div class="beta-notice">
        <span class="beta-tag">Beta</span>
        DevRel(ish) is currently in public beta. Core features are stable and live, but you may encounter rough edges.
        Found something broken or have a suggestion? Reach out via any group's contact form — we'd love to hear from you.
      </div>
    </div>
  </div>

  <div class="hiw-body">

    <!-- ── For Community Members ───────────────────────────────────────── -->
    <section class="hiw-section">
      <div class="section-label">For members</div>
      <h2>Finding &amp; joining the community</h2>

      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Browse groups and events</h3>
            <p>
              Head to <a href="/groups">devrelish.tech/groups</a> to see all active communities,
              or <a href="/gatherings">devrelish.tech/gatherings</a> to browse upcoming events.
              You'll also find events from other ATProto-compatible apps like Smoke Signal —
              everything in the open calendar ecosystem shows up here.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Sign in with your Bluesky account</h3>
            <p>
              DevRel(ish) uses AT Protocol OAuth — if you have a Bluesky account, that's your login.
              No separate password or account needed. Your handle and identity come from your AT Protocol
              Personal Data Server (PDS), so they're yours regardless of what apps you use.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Join a group on ATProto</h3>
            <p>
              On any group's page, signed-in members can click <strong>Join on ATProto</strong>.
              This writes a membership record directly to your AT Protocol PDS, meaning your membership
              is stored in your own account — not just our database — and is readable by any compatible app.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">4</div>
          <div class="step-content">
            <h3>Follow for email updates</h3>
            <p>
              You can also enter your email on any group's page to follow via email.
              You'll receive a confirmation, and from then on you'll be notified when new gatherings are announced.
              You can unsubscribe at any time from any notification email.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">5</div>
          <div class="step-content">
            <h3>RSVP to a gathering</h3>
            <p>
              When a gathering is announced, RSVP directly on the event page.
              Signed-in users can RSVP with one click via their ATProto account — this writes an RSVP record
              to your PDS using the open <code>community.lexicon.calendar.rsvp</code> schema.
              You can also fill out the traditional form if you prefer not to sign in.
              Capacity is limited; spots are first come, first served.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">6</div>
          <div class="step-content">
            <h3>Cancel your RSVP if plans change</h3>
            <p>
              No account required to cancel. When you RSVP via the form, the confirmation page shows a personal
              cancellation link — bookmark it or save it somewhere handy.
              If you lose it, go back to the event's RSVP page and click
              <strong>Cancel your RSVP</strong> in the sidebar.
              Enter the email you registered with and we'll send the cancellation link to your inbox.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">7</div>
          <div class="step-content">
            <h3>Stay in the loop with RSS</h3>
            <p>
              Every group has an RSS feed at <code>/groups/[group-slug]/rss.xml</code>.
              Add it to your feed reader to get gathering announcements without email or a login.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── For Organizers ─────────────────────────────────────────────── -->
    <section class="hiw-section">
      <div class="section-label">For organizers</div>
      <h2>Launching &amp; managing a group</h2>

      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Register your group</h3>
            <p>
              Fill out the <a href="/groups/register">group registration form</a>.
              Provide your group's name, a description (50 characters minimum, Markdown supported),
              a contact email, and optionally a category, tags, and location.
              Your group goes live instantly — no approval queue, no waiting.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Sign in with your Bluesky account</h3>
            <p>
              Your Bluesky handle is your organizer login. Use AT Protocol OAuth on the
              <a href="/auth/login">sign-in page</a> to claim your group and access the dashboard.
              Your account is linked by your decentralized identifier (DID), so it works
              even if you change your handle or move to a different PDS.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Publish your group to the ATProto network</h3>
            <p>
              From the <a href="/dashboard">organizer dashboard</a>, publish your group to AT Protocol.
              This writes a <code>com.devrelish.group</code> record to your PDS, making your group
              discoverable across the ATProto ecosystem and enabling members to join via Bluesky.
              Gatherings you create are also published as open calendar records that compatible apps can index.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">4</div>
          <div class="step-content">
            <h3>Set up your group page</h3>
            <p>
              In the <a href="/dashboard/group">My Group</a> section of the dashboard you can edit
              your description, tagline, category, tags, location, and social links at any time.
              Your group name is set at registration — contact support if you need it changed.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">5</div>
          <div class="step-content">
            <h3>Add a custom short URL</h3>
            <p>
              Choose a custom short URL for your group such as <code>devrelish.tech/sf-user-group</code>.
              This makes it easier to share at events, on slides, or in email signatures.
              Short URLs can be changed at any time from <a href="/dashboard/group">My Group</a>.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">6</div>
          <div class="step-content">
            <h3>Announce a gathering</h3>
            <p>
              Go to <a href="/dashboard/gatherings">Gatherings</a> in the dashboard and click <strong>New gathering</strong>.
              Add a title, description, date, time, venue, and capacity.
              Once created, the gathering appears on your public group page and is published as an open
              <code>community.lexicon.calendar.event</code> record — compatible with Smoke Signal and other ATProto calendar apps.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">7</div>
          <div class="step-content">
            <h3>Import upcoming events from Meetup</h3>
            <p>
              Already running a group on Meetup.com? Use the <strong>Import from Meetup</strong> option in the
              Gatherings dashboard to pull in your upcoming events directly. Paste your Meetup group URL and
              DevRel(ish) will pre-fill the title, description, date, and time — you just confirm the venue and
              capacity before importing.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">8</div>
          <div class="step-content">
            <h3>Manage attendees</h3>
            <p>
              In the dashboard you can view the RSVP list for each gathering and export it as a CSV.
              The attendee list shows name, email, job title, and company for form-based RSVPs.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">9</div>
          <div class="step-content">
            <h3>Add co-organizers</h3>
            <p>
              Share the load by inviting co-organizers via the <a href="/dashboard/team">Team</a> page.
              Co-organizers sign in with their own Bluesky account and are added as co-organizers on
              your group's ATProto record. They have the same dashboard access as the primary organizer.
            </p>
          </div>
        </div>

        <div class="step">
          <div class="step-num">10</div>
          <div class="step-content">
            <h3>Respond to messages</h3>
            <p>
              Community members can send your group a message through the contact form on your public page.
              Messages land in your <a href="/dashboard/messages">Messages</a> inbox in the dashboard.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────────────────── -->
    <section class="hiw-section hiw-faq">
      <div class="section-label">FAQ</div>
      <h2>Common questions</h2>

      <div class="faq-list">
        <details class="faq-item">
          <summary>What is AT Protocol?</summary>
          <p>
            AT Protocol (atproto) is an open, decentralized protocol for building social apps — the same
            standard that powers Bluesky. Your identity is a DID (decentralized identifier) that you control,
            and your data lives on a Personal Data Server (PDS) that can be self-hosted or provided by a service.
            DevRel(ish) uses ATProto so that your RSVPs, group memberships, and event records belong to
            you — not a walled garden.
          </p>
        </details>

        <details class="faq-item">
          <summary>Do I need a Bluesky account?</summary>
          <p>
            You need an AT Protocol account to sign in as an organizer or to RSVP and join groups via ATProto.
            Bluesky is the most common way to get one, but any AT Protocol PDS works.
            You can still browse groups, view events, RSVP via the traditional form, and follow groups
            by email without signing in.
          </p>
        </details>

        <details class="faq-item">
          <summary>What is Smoke Signal, and how does interop work?</summary>
          <p>
            Smoke Signal is another ATProto-based event app that uses the same open
            <code>community.lexicon.calendar.event</code> and <code>community.lexicon.calendar.rsvp</code> schemas.
            Because both apps write events to the shared ATProto network using the same format,
            events created in DevRel(ish) can appear in Smoke Signal and vice versa.
            This is the practical benefit of open standards — your events aren't siloed.
          </p>
        </details>

        <details class="faq-item">
          <summary>Is DevRel(ish) free for organizers?</summary>
          <p>Yes, the platform is free for all organizers and community members.</p>
        </details>

        <details class="faq-item">
          <summary>What kinds of groups are accepted?</summary>
          <p>
            Groups focused on developer relations and adjacent roles — including developer advocacy,
            developer experience, technical writing, community management, and related fields.
            Groups are intended for in-person gatherings; online-only communities aren't the current focus.
            There is no manual approval step — groups go live immediately after registration.
          </p>
        </details>

        <details class="faq-item">
          <summary>Can I change my group's name?</summary>
          <p>
            Group names are set at registration to preserve recognition and existing links.
            If you have a compelling reason to rename your group, contact us and we'll discuss options.
          </p>
        </details>

        <details class="faq-item">
          <summary>What happens to follower emails?</summary>
          <p>
            Follower emails are only used to notify followers when your group announces a new gathering.
            Emails are never shared, sold, or used for any other purpose. Every email includes an unsubscribe link.
          </p>
        </details>

        <details class="faq-item">
          <summary>Can I close or pause my group?</summary>
          <p>
            Yes. If your group is no longer active, contact the DevRel(ish) team and we can mark it as closed.
            Closed groups remain visible but display a notice that the group is no longer active and stop
            appearing in the main event listings.
          </p>
        </details>
      </div>
    </section>

    <!-- ── CTA ───────────────────────────────────────────────────────── -->
    <section class="hiw-cta">
      <h2>Ready to get started?</h2>
      <p>Browse existing communities or register your own group today.</p>
      <div class="cta-actions">
        <a href="/groups" class="btn btn-primary">Browse groups</a>
        <a href="/groups/register" class="btn btn-ghost">Register a group</a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hiw-hero {
    background: var(--color-surface-warm);
    border-bottom: 2px solid var(--color-border);
    padding: 4rem 1.5rem 3rem;
  }

  .hiw-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .hiw-eyebrow {
    font-size: var(--size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .hiw-hero h1 {
    font-size: clamp(var(--size-2xl), 5vw, var(--size-4xl));
    margin: 0 0 1rem;
  }

  .hiw-lead {
    font-size: var(--size-lg);
    color: var(--color-text-light);
    line-height: 1.65;
    margin: 0;
    max-width: 600px;
  }

  .beta-notice {
    margin-top: 1.25rem;
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    max-width: 600px;
    line-height: 1.6;
  }

  .beta-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-light);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.1em 0.5em;
    flex-shrink: 0;
  }

  /* ── Body ─────────────────────────────────────────────────────────── */
  .hiw-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ── Section ──────────────────────────────────────────────────────── */
  .hiw-section {}

  .section-label {
    font-size: var(--size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .hiw-section h2 {
    font-size: var(--size-2xl);
    margin: 0 0 2rem;
  }

  /* ── Steps ────────────────────────────────────────────────────────── */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .step:last-child {
    border-bottom: none;
  }

  .step-num {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: var(--size-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step-content h3 {
    font-size: var(--size-base);
    margin: 0 0 0.375rem;
  }

  .step-content p {
    font-size: var(--size-sm);
    color: var(--color-text-light);
    line-height: 1.65;
    margin: 0;
    max-width: none;
  }

  .step-content code {
    font-size: 0.85em;
    background: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }

  /* ── FAQ ──────────────────────────────────────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px dashed var(--color-border);
    padding: 0;
  }

  .faq-item:first-child {
    border-top: 1px dashed var(--color-border);
  }

  .faq-item summary {
    font-weight: 600;
    font-size: var(--size-base);
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-item summary::after {
    content: "+";
    font-size: var(--size-lg);
    font-weight: 400;
    color: var(--color-primary);
    flex-shrink: 0;
    line-height: 1;
    transition: transform var(--transition);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    font-size: var(--size-sm);
    color: var(--color-text-light);
    line-height: 1.65;
    margin: 0 0 1rem;
    max-width: none;
  }

  /* ── CTA ──────────────────────────────────────────────────────────── */
  .hiw-cta {
    background: var(--color-surface-warm);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .hiw-cta h2 {
    font-size: var(--size-2xl);
    margin: 0 0 0.5rem;
  }

  .hiw-cta p {
    color: var(--color-text-light);
    margin: 0 0 1.5rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .step {
      grid-template-columns: 2rem 1fr;
      gap: 0.75rem;
    }

    .step-num {
      width: 2rem;
      height: 2rem;
      font-size: var(--size-xs);
    }

    .hiw-cta {
      padding: 2rem 1.25rem;
    }
  }
</style>
