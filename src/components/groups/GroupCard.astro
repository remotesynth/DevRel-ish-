---
/**
 * A group in a listing.
 *
 * Deliberately a different shape from the gathering entry — a group is a
 * standing thing, a gathering is a dated one. Where the gathering leads with a
 * date, this leads with the name; where that one is an open entry on a rule,
 * this is a bounded panel. Two card voices, not one copied twice.
 */
import { stripMarkdown } from "../../lib/markdown";
import { getCategoryLabel } from "../../lib/categories";
import { groupUrl } from "../../lib/utils";

interface Props {
  id: string;
  name: string;
  slug: string;
  customSlug?: string | null;
  city?: string | null;
  region?: string | null;
  country?: string | null;
  tagline?: string | null;
  category?: string | null;
  tags?: string | null;
  description: string;
  upcomingCount?: number;
}

const { name, slug, customSlug, city, region, country, tagline, category, tags, description, upcomingCount = 0 } =
  Astro.props;
const href = groupUrl({ slug, customSlug });

const location = city ? (region ? `${city}, ${region}` : country ? `${city}, ${country}` : city) : null;
const tagList = tags ? tags.split(",").map((t) => t.trim()).filter(Boolean) : [];
const plain = stripMarkdown(description);
const snippet = plain.length > 130 ? plain.slice(0, 130).trimEnd() + "…" : plain;
---

<article class="gcard">
  <div class="gcard-head">
    <h3 class="gcard-name"><a href={href}>{name}</a></h3>
    {location && <p class="gcard-place">{location}</p>}
  </div>

  {tagline && <p class="gcard-tagline">{tagline}</p>}
  <p class="gcard-desc">{snippet}</p>

  <div class="gcard-foot">
    <p class="gcard-count">
      {
        upcomingCount > 0 ? (
          <>
            <span class="count-n">{upcomingCount}</span>
            <span>upcoming</span>
          </>
        ) : (
          <span class="count-none">No dates yet</span>
        )
      }
    </p>
    {
      category && (
        <a href={`/groups?category=${encodeURIComponent(category)}`} class="gcard-cat">
          {getCategoryLabel(category) ?? category}
        </a>
      )
    }
  </div>

  {
    tagList.length > 0 && (
      <ul class="gcard-tags" role="list">
        {tagList.slice(0, 4).map((tag) => (
          <li>
            <a href={`/groups?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .gcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    min-width: 0;
    transition: border-color var(--dur-micro) var(--ease-out);
  }

  .gcard:hover {
    border-color: var(--color-ink);
  }

  .gcard-head {
    padding-bottom: var(--space-3xs);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .gcard-name {
    font-size: var(--text-lg);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .gcard-name a {
    text-decoration: none;
    color: var(--color-ink);
  }

  .gcard-name a:hover {
    color: var(--color-accent);
  }

  .gcard-place {
    font-family: var(--font-body);
    font-size: var(--text-2xs);

    color: var(--color-muted);
    max-width: none;
    margin-top: 0.15rem;
  }

  .gcard-tagline {
    font-size: var(--text-sm);
    color: var(--color-ink);
    max-width: none;
  }

  .gcard-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: none;
    flex: 1;
  }

  .gcard-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    flex-wrap: wrap;
    padding-top: var(--space-3xs);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .gcard-count {
    font-family: var(--font-body);
    font-size: var(--text-2xs);

    color: var(--color-muted);
    max-width: none;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .count-n {
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .gcard-cat {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: var(--rule-hair) solid var(--color-rule-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60%;
  }

  .gcard-cat:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .gcard-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .gcard-tags a {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.05rem 0.3rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-xs);
  }

  .gcard-tags a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
