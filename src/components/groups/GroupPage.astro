---
/**
 * Shared group page renderer used by both /groups/[slug] and /[customSlug].
 * Keeps the two routes in sync without duplicating markup.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import MeetupCard from "../meetups/MeetupCard.astro";
import { renderMarkdown, stripMarkdown } from "../../lib/markdown";
import { profileUrl } from "../../lib/atproto-identity";
import { getCategoryLabel } from "../../lib/categories";

import type { Groups, Meetups } from "astro:db";

interface Props {
  group: typeof Groups.$inferSelect;
  meetups: (typeof Meetups.$inferSelect)[];
  rsvpCounts: Record<string, number>;
  followerCount: number;
  memberCount?: number;
}

const { group, meetups, rsvpCounts, followerCount, memberCount = 0 } = Astro.props;

const isGroupClosed = group.status === "closed";

const tagList = group.tags ? group.tags.split(",").map(t => t.trim()).filter(Boolean) : [];

const location = group.city
  ? group.region
    ? `${group.city}, ${group.region}, ${group.country ?? ""}`
    : group.country
      ? `${group.city}, ${group.country}`
      : group.city
  : null;

const ogDescription = (() => {
  const base = group.tagline ?? stripMarkdown(group.description).slice(0, 120);
  const locationPart = location ? ` Based in ${location}.` : "";
  const countPart = meetups.length > 0 ? ` ${meetups.length} upcoming gathering${meetups.length === 1 ? "" : "s"}.` : "";
  return `${base}${locationPart}${countPart}`.slice(0, 200);
})();
---

<BaseLayout
  title={group.name}
  description={ogDescription}
>
  <section class="group-hero">
    <div class="container">
      <div class="group-meta-row">
        <a href="/groups" class="back-link">← All groups</a>
        {isGroupClosed
          ? <span class="badge badge-closed">Closed</span>
          : <span class="badge badge-approved">Active group</span>
        }
      </div>

      <h1>
        {group.name}
      </h1>

      {group.tagline && <p class="group-tagline">{group.tagline}</p>}

      <div class="group-details-row">
        {group.category && (
          <a href={`/groups?category=${encodeURIComponent(group.category)}`} class="category-chip">
            {getCategoryLabel(group.category) ?? group.category}
          </a>
        )}
        {location && <span class="group-location">{location}</span>}
        {tagList.map(tag => (
          <a href={`/groups?tag=${encodeURIComponent(tag)}`} class="tag-chip">{tag}</a>
        ))}
        {memberCount > 0 && (
          <span class="group-stat">
            <span class="at-mark" aria-hidden="true">◎</span>
            {memberCount} ATProto {memberCount === 1 ? "member" : "members"}
          </span>
        )}
      </div>

      {group.website || group.handle || group.linkedinUrl ? (
        <div class="social-links">
          {group.website && (
            <a href={group.website} class="social-link" target="_blank" rel="noopener noreferrer">
              Website
            </a>
          )}
          {group.handle && (
            <a href={profileUrl(group.handle)} class="social-link" target="_blank" rel="noopener noreferrer">
              ◎ @{group.handle.replace(/^@/, "")}
            </a>
          )}
          {group.linkedinUrl && (
            <a href={group.linkedinUrl} class="social-link" target="_blank" rel="noopener noreferrer">
              in LinkedIn
            </a>
          )}
        </div>
      ) : null}

      {!isGroupClosed && Astro.locals.user && group.atUri && group.atCid && (
        <div class="join-action">
          {Astro.url.searchParams.get("joined") === "atproto" ? (
            <span class="join-success">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              Joined on ATProto!
            </span>
          ) : (
            <form method="POST" action={`/api/groups/${group.id}/join`}>
              <button type="submit" class="btn btn-ghost btn-sm join-btn">
                <span class="at-mark" aria-hidden="true">◎</span>
                Join on ATProto
              </button>
            </form>
          )}
        </div>
      )}

      {isGroupClosed && (
        <div class="closed-notice">
          This group is no longer active. Prior gathering pages remain available for reference.
        </div>
      )}

      <div class="group-desc prose" set:html={renderMarkdown(group.description)} />

      {!isGroupClosed && (
        <div class="group-actions-row">
          <a href={`/groups/${group.slug}/contact`} class="contact-link">
            Have a question? Contact the organizers →
          </a>
          <p class="conduct-line">
            This group follows the DevRel(ish)
            <a href="/code-of-conduct">code of conduct</a>. Something wrong at an event?
            <a href={`/groups/${group.slug}/contact`}>Tell the organizers</a>, or
            <a href="/code-of-conduct#reporting">tell us</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  {!isGroupClosed && (
    <section class="follow-section">
      <div class="container">
        <div class="follow-card">
          <div class="follow-text">
            <strong>Follow this group</strong>
            <span>Get notified by email when new gatherings are posted.{followerCount > 0 ? ` ${followerCount} ${followerCount === 1 ? "person follows" : "people follow"} this group.` : ""}</span>
          </div>
          <div class="follow-actions">
            <form method="POST" action={`/groups/${group.slug}/follow`} class="follow-form">
              <input type="email" name="email" placeholder="your@email.com" required class="follow-input" />
              <button type="submit" class="btn btn-primary btn-sm">Follow →</button>
            </form>
            <a href={`/groups/${group.slug}/rss.xml`} class="rss-link" title="RSS feed">
              RSS feed
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="meetups-section">
    <div class="container">
      <h2>Upcoming gatherings</h2>

      {
        meetups.length === 0 ? (
          <div class="empty-meetups">
            <div class="empty-icon" aria-hidden="true">✦</div>
            <p>No gatherings scheduled yet. Check back soon!</p>
          </div>
        ) : (
          <div class="meetups-list">
            {meetups.map((m) => (
              <MeetupCard
                id={m.id}
                title={m.title}
                description={m.description}
                date={m.date}
                time={m.time}
                venue={m.venue}
                address={m.address}
                city={m.city}
                country={m.country}
                eventContext={m.eventContext}
                capacity={m.capacity}
                rsvpCount={rsvpCounts[m.id] ?? 0}
                groupSlug={group.slug}
                status={m.status}
                groupClosed={isGroupClosed}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .group-hero {
    padding: 3rem 0 2rem;
    background: var(--color-paper-2);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .group-meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink-2);
  }

  .back-link:hover { color: var(--color-accent); }

  h1 { margin-bottom: 0.375rem; }

  .group-tagline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-ink-2);
    margin-bottom: 0.75rem;
    max-width: none;
  }

  .group-details-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .group-location {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .group-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ok);
    background: var(--color-ok-wash);
    border: var(--rule-hair) solid var(--color-ok-wash);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
  }

  .category-chip {
    font-size: var(--text-xs);
    font-weight: 700;
    background: var(--color-accent-wash);
    color: var(--color-accent);
    border: var(--rule-hair) solid var(--color-accent);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
    text-decoration: none;
    transition: background var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
  }

  .category-chip:hover {
    background: var(--color-accent-wash);
    border-color: var(--color-accent);
  }

  .tag-chip {
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }

  .tag-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .social-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink-2);
    text-decoration: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.7rem;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out);
  }

  .social-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .closed-notice {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-2);
    background: var(--color-paper-3);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.875rem;
    margin-bottom: 1rem;
    max-width: none;
  }

  .group-desc {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.7;
    max-width: 64ch;
    margin-bottom: 1rem;
  }

  .group-desc :global(p) { margin-bottom: 0.75rem; }
  .group-desc :global(p:last-child) { margin-bottom: 0; }
  .group-desc :global(h1), .group-desc :global(h2), .group-desc :global(h3) {
    color: var(--color-ink);
    margin: 1rem 0 0.375rem;
  }
  .group-desc :global(ul), .group-desc :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .group-desc :global(li) { margin-bottom: 0.25rem; }
  .group-desc :global(strong) { color: var(--color-ink); }
  .group-desc :global(a) { color: var(--color-accent); }
  .group-desc :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.875em;
    background: var(--color-paper);
    padding: 0.1em 0.3em;
    border-radius: var(--radius-sm);
  }
  .group-desc :global(blockquote) {
    border-left: var(--rule-thick) solid var(--color-rule-strong);
    padding-left: 1rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 0.75rem 0;
  }

  .join-action {
    margin-bottom: 0.75rem;
  }

  .join-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .join-success {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ok);
  }

  .at-mark {
    line-height: 1;
    opacity: 0.9;
  }

  .contact-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-2);
    text-decoration: none;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-full);
    padding: 0.375rem 0.875rem;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }

  .contact-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  /* Follow section */
  .follow-section {
    padding: 1.25rem 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper);
  }

  .follow-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .follow-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .follow-text strong {
    font-size: var(--text-base);
  }

  .follow-text span {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .follow-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .follow-form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .follow-input {
    font-size: var(--text-sm);
    padding: 0.45rem 0.75rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    color: var(--color-ink);
    min-width: 220px;
  }

  .follow-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .rss-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .rss-link:hover { color: var(--color-accent); }

  /* Gatherings section */
  .meetups-section {
    padding: 2.5rem 0 4rem;
  }

  .meetups-section h2 { margin-bottom: 1.5rem; }

  .meetups-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 720px;
  }

  .empty-meetups {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    max-width: 400px;
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--color-accent);
    opacity: 0.3;
    margin-bottom: 0.75rem;
  }

  .empty-meetups p {
    color: var(--color-ink-2);
    max-width: none;
  }

  .group-actions-row {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
  }

  .conduct-line {
    font-size: var(--text-xs);
    color: var(--color-muted);
    max-width: var(--measure);
  }

</style>
