---
import { formatTime, osmUrl, groupUrl, spotsLeft as spotsRemaining, isOnline } from "../../lib/utils";
import { renderMarkdown } from "../../lib/markdown";

interface Props {
  id: string;
  title: string;
  description: string;
  date: Date;
  time: string;
  mode?: string | null;
  venue?: string | null;
  address?: string | null;
  city?: string | null;
  country?: string | null;
  eventContext?: string | null;
  tags?: string | null;
  capacity: number | null;
  rsvpCount: number;
  groupName: string;
  groupSlug: string;
  groupCustomSlug?: string | null;
  status?: string;
}

const {
  id, title, description, date, time, mode, venue, address,
  city, country, eventContext, tags,
  capacity, rsvpCount, groupName, groupSlug, groupCustomSlug, status = "active",
} = Astro.props;
const groupHref = groupUrl({ slug: groupSlug, customSlug: groupCustomSlug });

const isCanceled = status === "canceled";
const spotsLeft = spotsRemaining(capacity, rsvpCount);
const isFull = spotsLeft !== null && spotsLeft === 0;
const online = isOnline(mode);
const descHtml = renderMarkdown(description);
const tagList = tags ? tags.split(",").map(t => t.trim()).filter(Boolean) : [];

const locationParts = [city, country].filter(Boolean).join(", ");
const locationLine = eventContext
  ? locationParts ? `${eventContext} · ${locationParts}` : eventContext
  : locationParts;
---

<article class:list={["gathering-card card", { canceled: isCanceled }]}>
  <div class="card-top">
    <div class:list={["date-block", { "date-canceled": isCanceled }]}>
      <span class="date-month">
        {new Intl.DateTimeFormat("en-US", { month: "short" }).format(date)}
      </span>
      <span class="date-day">{date.getDate()}</span>
    </div>

    <div class="card-main">
      <p class="group-label">
        <a href={groupHref} class="group-link">{groupName}</a>
      </p>
      <h3 class="gathering-title">
        {title}
        {isCanceled && <span class="badge-canceled">Cancelled</span>}
      </h3>
      <p class="gathering-where">
        {formatTime(time)} &bull; {venue ? (
          <a href={osmUrl(venue, address)} class="venue-link" target="_blank" rel="noopener noreferrer">{venue}</a>
        ) : (
          <span class="venue-online">Online</span>
        )}
        {online && venue && <span class="location-context"> · also online</span>}
        {locationLine && <span class="location-context"> · {locationLine}</span>}
      </p>
    </div>
  </div>

  <div class="gathering-desc" set:html={descHtml} />

  {tagList.length > 0 && (
    <div class="tag-list">
      {tagList.map(tag => (
        <a href={`/gatherings?tag=${encodeURIComponent(tag)}`} class="tag-chip">{tag}</a>
      ))}
    </div>
  )}

  <div class="card-footer">
    <div class="card-stats">
      {isCanceled ? (
        <span class="canceled-note">This gathering has been cancelled.</span>
      ) : isFull ? (
        <span class="badge badge-full">Full</span>
      ) : (
        <span class="spots-left">
          {spotsLeft === null
            ? "Open to all"
            : <Fragment><strong>{spotsLeft}</strong> of {capacity} spots left</Fragment>}
        </span>
      )}
    </div>
    {!isCanceled && !isFull && (
      <a href={`/gatherings/${id}/rsvp`} class="btn btn-primary btn-sm">RSVP →</a>
    )}
  </div>
</article>

<style>
  .gathering-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    /* Without a boundary the entry ran straight into the next one: the gap
       between cards (20px) was barely larger than the gap inside one (14px),
       and the only rule on the page was the dashed one *inside* each card. */
    border-top: var(--rule-thin) solid var(--color-rule-strong);
    padding-top: var(--space-sm);
  }

  .gathering-card.canceled {
    opacity: 0.75;
  }

  .card-top {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    padding: 0.375rem 0.75rem;
    min-width: 52px;
    flex-shrink: 0;
    line-height: 1;
  }

  .date-block.date-canceled {
    background: var(--color-muted);
  }

  .date-month {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .date-day {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .card-main {
    flex: 1;
    min-width: 0;
  }

  .group-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
    max-width: none;
  }

  .group-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .group-link:hover {
    text-decoration: underline;
  }

  .gathering-title {
    font-size: var(--text-lg);
    line-height: 1.3;
    margin-bottom: var(--space-3xs);
  }

  .badge-canceled {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-danger-wash);
    color: var(--color-danger);
    border-radius: var(--radius-full);
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .gathering-where {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: none;
  }

  .venue-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .venue-link:hover {
    color: var(--color-accent);
    text-decoration-style: solid;
  }

  .location-context {
    color: var(--color-muted);
  }

  .gathering-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gathering-desc :global(p) { margin: 0; }
  .gathering-desc :global(p + p) { margin-top: 0.375rem; }
  .gathering-desc :global(strong) { color: var(--color-ink); }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-chip {
    font-size: var(--text-xs);
    font-weight: 600;
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.6rem;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }

  .tag-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: auto;
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule-2);
  }

  .spots-left {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .spots-left strong {
    color: var(--color-ok);
  }

  .canceled-note {
    font-size: var(--text-sm);
    color: var(--color-danger);
    font-weight: 600;
  }

  .venue-online {
    font-weight: 600;
  }
</style>
