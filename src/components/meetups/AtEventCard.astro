---
import { atEventPath, formatPlace, isCancelled, parseUris, sourceAppName } from "../../lib/at-events";

interface Props {
  uri: string;
  did: string;
  name: string;
  startsAt: string;
  locationJson: string | null;
  urisJson?: string | null;
  status?: string | null;
  groupName: string | null;
}

const { uri, name, startsAt, locationJson, urisJson = null, status = null, groupName } = Astro.props;

const startDate = new Date(startsAt);
const valid = !isNaN(startDate.getTime());
const formattedDate = valid
  ? new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric" }).format(startDate)
  : "Date TBC";
const formattedTime = valid
  ? new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", hour12: true }).format(startDate)
  : "";

const placeDisplay = formatPlace(locationJson);
const uris = parseUris(urisJson);
const cancelled = isCancelled(status);

// Every network event now has a page here — previously these cards were a dead
// end with no link at all.
const href = atEventPath(uri);
const attribution = groupName ?? sourceAppName(uris) ?? "the Atmosphere";
---

<a class:list={["at-event-card", { cancelled }]} href={href ?? "#"} aria-disabled={href ? undefined : "true"}>
  <div class="at-event-header">
    <span class="at-badge">
      <span class="at-badge-mark" aria-hidden="true">◎</span>
      Via ATProto
    </span>
    <div class="at-event-date">
      {formattedDate}{formattedTime && ` · ${formattedTime}`}
    </div>
  </div>
  <h3 class="at-event-title">{name}</h3>
  {cancelled && <p class="at-event-cancelled">Cancelled</p>}
  {placeDisplay && <p class="at-event-location">📍 {placeDisplay}</p>}
  <p class="at-event-attribution">By {attribution}</p>
</a>

<style>
  .at-event-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.125rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition),
      box-shadow var(--transition),
      border-color var(--transition);
  }

  .at-event-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-strong);
    color: inherit;
  }

  .at-event-card.cancelled .at-event-title {
    text-decoration: line-through;
    opacity: 0.7;
  }

  .at-event-cancelled {
    font-size: var(--size-xs);
    font-weight: 700;
    color: oklch(45% 0.18 25);
    margin: 0;
    max-width: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .at-event-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .at-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--size-xs);
    font-weight: 700;
    color: var(--color-accent-dark);
    background: color-mix(in oklch, var(--color-accent) 12%, var(--color-bg));
    border: 1px solid color-mix(in oklch, var(--color-accent) 30%, var(--color-bg));
    border-radius: var(--radius-full);
    padding: 0.1rem 0.5rem;
  }

  .at-badge-mark {
    line-height: 1;
  }

  .at-event-date {
    font-size: var(--size-xs);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .at-event-title {
    font-size: var(--size-base);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .at-event-location {
    font-size: var(--size-xs);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
  }

  .at-event-attribution {
    font-size: var(--size-xs);
    color: var(--color-text-light);
    margin: 0;
    max-width: none;
  }
</style>
