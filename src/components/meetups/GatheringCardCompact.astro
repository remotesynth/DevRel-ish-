---
/**
 * The listing entry for a gathering.
 *
 * Was one of five near-identical bordered cards with the same radius, the same
 * 2px border, and the same hover lift. Now it's a dated entry: the date is the
 * anchor set in the display face, hairlines separate rather than enclose, and
 * the only hover signal is the rule going to ink.
 */
import { formatTime, osmUrl, spotsLeft as spotsRemaining, isOnline } from "../../lib/utils";

interface Props {
  id: string;
  title: string;
  date: Date;
  time: string;
  mode?: string | null;
  venue?: string | null;
  address?: string | null;
  city?: string | null;
  country?: string | null;
  eventContext?: string | null;
  capacity: number | null;
  rsvpCount: number;
  groupName: string;
}

const { id, title, date, time, mode, venue, address, city, country, eventContext, capacity, rsvpCount, groupName } =
  Astro.props;

const spotsLeft = spotsRemaining(capacity, rsvpCount);
const isFull = spotsLeft !== null && spotsLeft === 0;
const nearlyFull = spotsLeft !== null && !isFull && spotsLeft <= 5;
const online = isOnline(mode);

const locationParts = [city, country].filter(Boolean).join(", ");
const locationLine = eventContext
  ? locationParts
    ? `${eventContext} · ${locationParts}`
    : eventContext
  : locationParts;

const month = new Intl.DateTimeFormat("en-US", { month: "short" }).format(date);
const day = date.getDate();
const weekday = new Intl.DateTimeFormat("en-US", { weekday: "short" }).format(date);
---

<article class="entry">
  <a href={`/gatherings/${id}/rsvp`} class="entry-link">
    <div class="entry-date">
      <span class="d-weekday">{weekday}</span>
      <span class="d-day">{day}</span>
      <span class="d-month">{month}</span>
    </div>
    <div class="entry-body">
      <p class="entry-group">{groupName}</p>
      <h3 class="entry-title">{title}</h3>
    </div>
  </a>

  <p class="entry-where">
    <time class="entry-time">{formatTime(time)}</time>
    <span class="sep" aria-hidden="true">·</span>
    {venue ? (
      <a href={osmUrl(venue, address)} target="_blank" rel="noopener noreferrer">{venue}</a>
    ) : (
      <span class="venue-online">Online</span>
    )}
    {online && venue && <span class="entry-place">also online</span>}
    {locationLine && <span class="entry-place">{locationLine}</span>}
  </p>

  <p class="entry-spots">
    {
      isFull ? (
        <span class="badge badge-full">Full</span>
      ) : spotsLeft === null ? (
        <span class="spots-of">Open to all</span>
      ) : (
        <>
          <span class:list={["spots-n", { low: nearlyFull }]}>{spotsLeft}</span>
          <span class="spots-of">of {capacity} spots left</span>
        </>
      )
    }
  </p>
</article>

<style>
  .entry {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
    transition: border-top-color var(--dur-micro) var(--ease-out);
  }

  .entry:hover {
    border-top-color: var(--color-ink);
  }

  .entry-link {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-xs);
    align-items: start;
    text-decoration: none;
    color: inherit;
  }

  /* The date is the anchor — set in the display face, not a coloured tile. */
  .entry-date {
    display: grid;
    justify-items: start;
    line-height: 1;
    padding-top: 0.15rem;
  }

  .d-weekday,
  .d-month {
    font-family: var(--font-body);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .d-day {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .entry-group {
    font-family: var(--font-body);
    font-size: var(--text-2xs);

    color: var(--color-muted);
    max-width: none;
    margin-bottom: 0.1rem;
  }

  .entry-title {
    font-size: var(--text-lg);
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  .entry-link:hover .entry-title {
    color: var(--color-accent);
  }

  .entry-where {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
  }

  .entry-time {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  .sep {
    color: var(--color-rule-strong);
  }

  .entry-place {
    color: var(--color-muted);
    font-size: var(--text-xs);
    flex-basis: 100%;
  }

  .entry-spots {
    max-width: none;
    font-size: var(--text-xs);
    color: var(--color-muted);
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .spots-n {
    font-family: var(--font-body);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .spots-n.low {
    color: var(--color-notice);
  }

  .venue-online {
    font-weight: 600;
  }
</style>
