---
import { formatDate, formatTime, spotsLeft, osmUrl, isOnline } from "../../lib/utils";
import { renderMarkdown } from "../../lib/markdown";

interface Props {
  id: string;
  title: string;
  description: string;
  date: Date;
  time: string;
  mode?: string | null;
  venue?: string | null;
  address?: string | null;
  city?: string | null;
  country?: string | null;
  eventContext?: string | null;
  capacity: number | null;
  rsvpCount: number;
  groupSlug?: string;
  status?: string;
  groupClosed?: boolean;
}

const { id, title, description, date, time, mode, venue, address, city, country, eventContext, capacity, rsvpCount, groupSlug, status = "active", groupClosed = false } = Astro.props;

const isCanceled = status === "canceled";
const spots = spotsLeft(capacity, rsvpCount);
const isFull = spots !== null && spots === 0;
const online = isOnline(mode);
const descHtml = renderMarkdown(description);
---

<article class:list={["meetup-card card", { canceled: isCanceled }]}>
  <div class="meetup-meta">
    <div class:list={["meetup-date-block", { "date-canceled": isCanceled }]}>
      <span class="date-month">
        {new Intl.DateTimeFormat("en-US", { month: "short" }).format(date)}
      </span>
      <span class="date-day">{date.getDate()}</span>
    </div>
    <div class="meetup-info">
      <h3 class="meetup-title">
        {title}
        {isCanceled && <span class="badge-canceled">Cancelled</span>}
      </h3>
      <p class="meetup-time">
        {formatTime(time)} &bull; {venue ? (
          <a href={osmUrl(venue, address)} class="venue-link" target="_blank" rel="noopener noreferrer">{venue}</a>
        ) : (
          <span class="venue-online">Online</span>
        )}
        {online && venue && <span class="event-context"> · also online</span>}
        {eventContext && <span class="event-context"> · {eventContext}</span>}
        {!eventContext && city && <span class="event-context"> · {country ? `${city}, ${country}` : city}</span>}
      </p>
    </div>
  </div>

  <div class="meetup-desc" set:html={descHtml} />

  <div class="meetup-footer">
    <div class="meetup-stats">
      {isCanceled ? (
        <span class="canceled-note">This gathering has been cancelled.</span>
      ) : isFull ? (
        <span class="badge badge-full">Full</span>
      ) : (
        <span class="spots-left">
          {spots === null
            ? "Open to all"
            : <Fragment><strong>{spots}</strong> of {capacity} spots left</Fragment>}
        </span>
      )}
    </div>
    {!isCanceled && !groupClosed && !isFull && (
      <a href={`/gatherings/${id}/rsvp`} class="btn btn-primary btn-sm">
        RSVP →
      </a>
    )}
  </div>
</article>

<style>
  .meetup-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    /* Without a boundary the entry ran straight into the next one: the gap
       between cards (20px) was barely larger than the gap inside one (14px),
       and the only rule on the page was the dashed one *inside* each card. */
    border-top: var(--rule-thin) solid var(--color-rule-strong);
    padding-top: var(--space-sm);
  }

  .meetup-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .meetup-card.canceled {
    opacity: 0.75;
  }

  .meetup-date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
    padding: 0.375rem 0.75rem;
    min-width: 52px;
    flex-shrink: 0;
    line-height: 1;
  }

  .meetup-date-block.date-canceled {
    background: var(--color-muted);
  }

  .date-month {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .date-day {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .meetup-info {
    flex: 1;
  }

  .meetup-title {
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .meetup-time {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    margin-top: var(--space-3xs);
    max-width: none;
  }

  .venue-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .venue-link:hover {
    color: var(--color-accent);
    text-decoration-style: solid;
  }

  .event-context {
    color: var(--color-muted);
  }

  .meetup-desc {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: none;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meetup-desc :global(p) { margin: 0; }
  .meetup-desc :global(p + p) { margin-top: 0.375rem; }
  .meetup-desc :global(ul),
  .meetup-desc :global(ol) { padding-left: 1.25rem; margin: 0; }
  .meetup-desc :global(strong) { color: var(--color-ink); }

  .meetup-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-top: auto;
    padding-top: var(--space-2xs);
    border-top: var(--rule-hair) solid var(--color-rule-2);
  }

  .spots-left {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }

  .spots-left strong {
    color: var(--color-ok);
  }

  .badge-canceled {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-danger-wash);
    color: var(--color-danger);
    border-radius: var(--radius-full);
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .canceled-note {
    font-size: var(--text-sm);
    color: var(--color-danger);
    font-weight: 600;
  }

  .venue-online {
    font-weight: 600;
  }
</style>
