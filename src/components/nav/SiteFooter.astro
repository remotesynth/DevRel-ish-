---
/**
 * Ft4 · Dense colophon.
 *
 * The previous footer was the compressed AI shape — brand blurb, link column,
 * hairline, tiny copyright. A colophon is the print convention for stating how
 * a thing was made and on what, which is exactly the note this site needs to
 * end on: your records aren't here, they're yours.
 */
const year = new Date().getFullYear();
---

<footer class="colophon">
  <hr class="rule-double" aria-hidden="true" />
  <div class="container colophon-inner">
    <nav class="colophon-links" aria-label="Footer navigation">
      <a href="/gatherings">Gatherings</a>
      <a href="/groups">Groups</a>
      <a href="/groups/register">Start a group</a>
      <a href="/how-it-works">How it works</a>
      <a href="/auth/login">Organizer sign-in</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <p class="colophon-text">
      <strong>DevRel(ish)</strong> — in-person gatherings for developer relations
      and the roles around it. Set in Fraunces and Source Serif&nbsp;4, with
      JetBrains Mono for identifiers. Built on the
      <a href="https://atproto.com" target="_blank" rel="noopener noreferrer">AT&nbsp;Protocol</a>:
      groups, events, and RSVPs are
      <code class="ident">community.lexicon.calendar.*</code> and
      <code class="ident">com.devrelish.*</code> records written to
      <em>your</em> Personal Data Server, not ours. We run no PDS, store no
      passwords, and hold nothing you can't take with you. Events shown here
      also come from Smoke&nbsp;Signal, atmo.rsvp, and OpenMeet, because they
      publish the same open schema. No account needed to attend — only to
      organize. {year}.
    </p>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--space-3xl);
  }

  .colophon-inner {
    padding-top: var(--space-md);
    padding-bottom: var(--space-2xl);
    display: grid;
    gap: var(--space-sm);
  }

  .colophon-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .colophon-links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    padding-bottom: 1px;
    white-space: nowrap;
  }

  .colophon-links a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* The colophon proper — one dense block, ragged right, mono-adjacent. */
  .colophon-text {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.75;
    letter-spacing: 0.005em;
    color: var(--color-muted);
    max-width: 74ch;
  }

  .colophon-text strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .colophon-text em {
    font-style: italic;
    color: var(--color-ink-2);
  }

  .colophon-text a {
    color: var(--color-accent);
  }

  .colophon-text code {
    font-size: 1em;
    color: var(--color-ink-2);
  }

  @media (max-width: 40rem) {
    .colophon-text {
      font-size: var(--text-2xs);
      line-height: 1.7;
    }
  }
</style>
