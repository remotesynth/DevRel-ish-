---
/**
 * N6 · Newspaper masthead.
 *
 * The previous nav was the canonical AI shape — wordmark left, inline links,
 * CTA button right, sticky, hairline border. It told you nothing about what
 * kind of site you were on. A masthead does: this is a community publication
 * about what's happening and where.
 *
 * The issue line carries live counts rather than a fake date, so it earns its
 * place as a discovery signal instead of reading as costume.
 */
import { db, Groups, Meetups, count, eq, and, gte } from "astro:db";

interface Props {
  user: App.Locals["user"];
}
const { user } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const [groupRow] = await db
  .select({ val: count() })
  .from(Groups)
  .where(eq(Groups.status, "active"));

const [gatheringRow] = await db
  .select({ val: count() })
  .from(Meetups)
  .where(and(eq(Meetups.status, "active"), gte(Meetups.date, today)));

const groupCount = groupRow?.val ?? 0;
const gatheringCount = gatheringRow?.val ?? 0;

const edition = new Intl.DateTimeFormat("en-US", {
  month: "long",
  year: "numeric",
}).format(today);
---

<header class="mast">
  <div class="container mast-inner">
    <p class="mast-line">
      <span>{edition}</span>
      <span class="mast-dot" aria-hidden="true">·</span>
      <span>{groupCount} {groupCount === 1 ? "group" : "groups"}</span>
      <span class="mast-dot" aria-hidden="true">·</span>
      <span>{gatheringCount} upcoming</span>
      <span class="mast-dot" aria-hidden="true">·</span>
      <span>on the AT Protocol</span>
    </p>

    <a href="/" class="mast-name" aria-label="DevRel(ish) home">
      DevRel<span class="mast-ish">(ish)</span>
    </a>

    <div class="mast-navrow">
      <button class="mast-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
        Menu
      </button>

      <nav class="mast-nav" aria-label="Primary">
        <ul id="nav-links" role="list">
          <li>
            <a href="/gatherings" class:list={["mast-link", { active: isActive("/gatherings") }]}>
              Gatherings
            </a>
          </li>
          <li>
            <a
              href="/groups"
              class:list={["mast-link", { active: isActive("/groups") && !isActive("/groups/register") }]}
            >
              Groups
            </a>
          </li>
          <li>
            <a href="/how-it-works" class:list={["mast-link", { active: isActive("/how-it-works") }]}>
              How it works
            </a>
          </li>
          <li>
            <a href="/groups/register" class:list={["mast-link", { active: isActive("/groups/register") }]}>
              Start a group
            </a>
          </li>
          {
            user ? (
              <>
                <li>
                  <a
                    href={user.role === "admin" ? "/admin" : "/dashboard"}
                    class:list={["mast-link", { active: isActive(user.role === "admin" ? "/admin" : "/dashboard") }]}
                  >
                    {user.role === "admin" ? "Admin" : "My group"}
                  </a>
                </li>
                <li><a href="/auth/signout" class="mast-link">Sign out</a></li>
              </>
            ) : (
              <li>
                <a href="/auth/login" class:list={["mast-link", { active: isActive("/auth/login") }]}>
                  Sign in
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <hr class="rule-double" aria-hidden="true" />
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });
</script>

<style>
  .mast {
    background: var(--color-paper);
    position: relative;
    z-index: var(--z-header);
  }

  .mast-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    padding-top: var(--space-sm);
    padding-bottom: var(--space-xs);
    text-align: center;
  }

  /* The issue line — small caps, mono, live counts. */
  .mast-line {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4em;
    font-variant-numeric: tabular-nums;
  }

  .mast-dot {
    color: var(--color-rule-strong);
  }

  .mast-name {
    font-family: var(--font-display);
    font-variation-settings: "SOFT" 0, "WONK" 1;
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .mast-name:hover {
    color: var(--color-accent);
  }

  .mast-ish {
    color: var(--color-accent);
  }

  .mast-navrow {
    display: contents;
  }

  .mast-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    list-style: none;
    margin-top: var(--space-3xs);
  }

  .mast-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: var(--rule-thin) solid transparent;
    white-space: nowrap;
    transition:
      color var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out);
  }

  .mast-link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-rule-strong);
  }

  .mast-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .mast-toggle {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--color-ink);
    border: var(--rule-thin) solid var(--color-rule-strong);
    border-radius: var(--radius-xs);
    padding: 0.4rem 0.9rem;
    min-height: 2.75rem;
    cursor: pointer;
    margin-top: var(--space-2xs);
  }

  .mast-toggle:hover {
    border-color: var(--color-ink);
  }

  /* Below the typography breakpoint the nav row collapses behind a
     disclosure, per the N6 responsive contract. */
  @media (max-width: 40rem) {
    .mast-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .mast-nav ul {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
      width: 100%;
      padding-block: var(--space-sm);
    }

    .mast-nav ul.open {
      display: flex;
    }
  }
</style>
