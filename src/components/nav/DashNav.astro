---
import { db, ContactMessages, count, eq, and } from "astro:db";

interface Props {
  user: App.Locals["user"];
}
const { user } = Astro.props;
const path = Astro.url.pathname;
const isAdmin = user?.role === "admin";

let unreadMessages = 0;
if (user?.groupId) {
  const [result] = await db
    .select({ val: count() })
    .from(ContactMessages)
    .where(and(eq(ContactMessages.groupId, user.groupId), eq(ContactMessages.read, false)));
  unreadMessages = result?.val ?? 0;
}

function isActive(href: string) {
  return path === href || path.startsWith(href + "/");
}
---

<aside class="dash-nav">
  <div class="dash-nav-inner">
    <a href="/" class="dash-logo">
      DevRel<span class="logo-ish">(ish)</span>
    </a>

    <div class="dash-user">
      <div class="user-avatar" aria-hidden="true">
        {(user?.displayName ?? user?.handle)?.[0]?.toUpperCase() ?? "?"}
      </div>
      <div>
        <p class="user-name">{user?.displayName ?? user?.handle}</p>
        <p class="user-email">@{user?.handle}</p>
      </div>
    </div>

    <nav aria-label="Dashboard navigation">
      {isAdmin && (
        <>
          <p class="nav-section-label">Admin</p>
          <ul class="dash-menu" role="list">
            <li>
              <a href="/admin/groups" class:list={["dash-link", { active: isActive("/admin/groups") }]}>
                ◈ All Groups
              </a>
            </li>
          </ul>
        </>
      )}

      <p class="nav-section-label">Organizer</p>
      <ul class="dash-menu" role="list">
        <li>
          <a href="/dashboard" class:list={["dash-link", { active: path === "/dashboard" }]}>
            ◎ Overview
          </a>
        </li>
        <li>
          <a href="/dashboard/group" class:list={["dash-link", { active: isActive("/dashboard/group") }]}>
            ◈ My Group
          </a>
        </li>
        <li>
          <a href="/dashboard/gatherings" class:list={["dash-link", { active: isActive("/dashboard/gatherings") }]}>
            ✦ Gatherings
          </a>
        </li>
        <li>
          <a href="/dashboard/messages" class:list={["dash-link", { active: isActive("/dashboard/messages") }]}>
            <span class="nav-link-inner">
              ✉ Messages
              {unreadMessages > 0 && <span class="nav-badge">{unreadMessages}</span>}
            </span>
          </a>
        </li>
        <li>
          <a href="/dashboard/team" class:list={["dash-link", { active: isActive("/dashboard/team") }]}>
            ◎ Team
          </a>
        </li>
      </ul>
    </nav>

    <div class="dash-nav-footer">
      <a href="/" class="dash-link dash-link-sm">← Public site</a>
      <a href="/how-it-works" class="dash-link dash-link-sm">? How it works</a>
      <form method="post" action="/auth/signout">
        <button type="submit" class="dash-link dash-link-sm signout-button">Sign out</button>
      </form>
    </div>
  </div>
</aside>

<style>
  .dash-nav {
    width: 240px;
    min-height: 100vh;
    background: var(--color-paper);
    border-right: var(--rule-hair) solid var(--color-rule);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .dash-nav-inner {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
    height: 100vh;
    overflow-y: auto;
  }

  .dash-logo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-accent);
    text-decoration: none;
    display: block;
  }

  .logo-ish {
    color: var(--color-ink-2);
    font-size: 0.85em;
  }

  .dash-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
    border: var(--rule-hair) solid var(--color-rule);
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .user-name {
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.3;
    max-width: none;
  }

  .user-email {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    max-width: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-section-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-2);
    padding: 0 0.75rem;
    margin-bottom: 0.125rem;
    margin-top: 0.25rem;
    max-width: none;
  }

  .dash-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dash-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    transition:
      color var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out);
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
  }

  .dash-link:hover,
  .dash-link.active {
    color: var(--color-accent);
    background: var(--color-paper-2);
  }

  .dash-link-sm {
    font-size: var(--text-xs);
    padding: 0.375rem 0.75rem;
  }

  .signout-button {
    width: 100%;
    font-family: inherit;
    text-align: left;
    border: 0;
    cursor: pointer;
  }

  .nav-link-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .nav-badge {
    font-size: 10px;
    font-weight: 700;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-full);
    padding: 0.1rem 0.4rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .dash-nav-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: var(--rule-hair) dashed var(--color-rule);
    padding-top: 1rem;
  }

  @media (max-width: 768px) {
    .dash-nav {
      width: 100%;
      min-height: auto;
    }

    .dash-nav-inner {
      height: auto;
      position: static;
    }

    .dash-menu {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
