# ── Required (dev + production) ───────────────────────────────────────────────

# Your site's public URL — no trailing slash.
# Dev:  http://localhost:4321
# Prod: https://your-site.netlify.app
PUBLIC_URL=http://localhost:4321

# ── ATProto OAuth (production only) ──────────────────────────────────────────
# ES256 private key for authenticating your app to users' PDSes.
# Not needed in development — the http://localhost client ID is used instead.
#
# Generate with:
#   node -e "
#     const { JoseKey } = require('@atproto/jwk-jose');
#     JoseKey.generate(['ES256']).then(k => console.log(JSON.stringify(k.privateJwk)));
#   "
#
# The resulting JSON string (starting with {"kty":"EC",...}) goes here.
ATPROTO_PRIVATE_KEY_JWK=

# ── Production only (Turso database) ─────────────────────────────────────────
# Sign up at https://turso.tech, then:
#   turso db create devrelish
#   turso db show devrelish --url      → ASTRO_DB_REMOTE_URL
#   turso db tokens create devrelish   → ASTRO_DB_APP_TOKEN
#
# After setting these, push the schema once before your first deploy:
#   npm run db:push

ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=

# ── First-run admin setup ─────────────────────────────────────────────────────
# Set this to a strong random secret to enable the /setup page.
# Generate with: openssl rand -base64 24
# After granting admin access at /setup, remove this variable
# from Netlify to permanently disable the setup page.

SETUP_TOKEN=

# Optional permanent administrators. Use comma-separated DIDs, not handles:
# did:plc:exampleone,did:web:example.org
# DIDs cannot be reassigned when an account's handle changes ownership.
ADMIN_DIDS=

# ── Resend (transactional email) ─────────────────────────────────────────────
# Sign up at https://resend.com, verify your domain, then create an API key.
# FROM address must use your verified domain.

RESEND_API_KEY=
RESEND_FROM=hello@devrelish.tech

# Where code-of-conduct reports go. Must NOT route to group organizers —
# reports are often about them. Shown publicly on /code-of-conduct.
CONDUCT_EMAIL=admin@devrelish.tech

# ── Cloudinary (speaker photo uploads) ───────────────────────────────────────
# Sign up at https://cloudinary.com and copy credentials from the Console → API Keys.
# Reveal the API Secret before copying — the dashboard masks it by default.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
